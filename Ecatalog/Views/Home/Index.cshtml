@{
    Layout = null;
    var SessionUserType = ViewBag.UserType;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TRW Parts Pro — Smart Parts Finder</title>

    <link href="~/Content/bootstrap.min.css" rel="stylesheet">
    <link href="~/Content/fonts.css" rel="stylesheet">
    <link href="~/Content/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/Content/bootstrap-icons.css">
    <link rel="stylesheet" href="~/Content/Site.css">
</head>
<body>
    @Html.Partial("~/Views/Parts/_Header.cshtml")
    <!-- MOBILE OVERLAY -->
    <div class="mob-overlay" id="mobOverlay"></div>

    <!-- MOBILE HAMBURGER -->
    <button class="mob-hamburger" id="mobHamburger" onclick="toggleSidebar()" aria-label="Toggle filter sidebar">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
    </button>

    <!-- ═══ APP LAYOUT ═══ -->
    <div class="app-layout">

        <!-- ════ SIDEBAR ════ -->
        @Html.Partial("~/Views/Parts/_Sidebar.cshtml")
        <!-- ════ MAIN ════ -->
        <main class="main-area" id="mainArea">
            <div class="main-content">
                <div class="row">
                    <!-- Selected Vehicle -->
                    <div class="col-lg-7 col-md-5 col-12">
                        <div class="hz" id="rz1">
                            <div class="rsh mb-2">
                                <span class="rsh-title col-8">Selected Vehicle</span>
                                <button class="clear-filter ms-auto" onclick="clearAllFilters()">
                                    <i class="bi bi-x-circle"></i> Clear Filter
                                </button>
                                @*<button class="clear-filter ms-auto" onclick="TestAPIADD()">
                                        <i class="bi bi-x-circle"></i> Test data
                                    </button>*@
                            </div>

                            <div class="veh-pills" id="vehSummary">
                                <div class="veh-empty">
                                    <i class="bi bi-car-front" style="font-size:1.1rem"></i>
                                    <span>Select vehicle attributes in the left panel to filter parts</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Customer Detail -->
                    <div class="col-lg-5 col-md-7 col-12">
                        <div class="hz" id="customerCard">
                            <div class="customer-info">
                                <div class="mb-2"><strong>-</strong></div>
                                <div style="display:grid; grid-template-columns:1fr 1fr; gap:0px 10px; font-size:10px;">
                                    <div><span class="text-muted">Salesman: </span><strong>-</strong></div>
                                    <div><span class="text-muted">Customer Code: </span><strong>-</strong></div>
                                    <div><span class="text-muted">Company: </span><strong>-</strong></div>
                                    <div><span class="text-muted">Rating: </span><strong>-</strong></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="hz" id="rz2">
                    <div class="rsh">
                        <span class="rsh-title">Product Results</span>
                        <span class="rcount" id="rcount">12 items</span>
                        <select class="sort-select ms-auto" id="sortSelect" onchange="sortProducts(this.value)">
                            <option value="carModel" selected>เรียงตาม: รุ่นรถ</option>
                            <option value="part">เรียงตาม: Part</option>
                            <option value="brand">เรียงตาม: ยี่ห้อสินค้า</option>
                            <option value="price-asc">ราคา: น้อย → มาก</option>
                            <option value="price-desc">ราคา: มาก → น้อย</option>
                            <option value="name">ชื่อ: A-Z</option>
                        </select>
                    </div>

                    <div class="active-filters" id="activeFilters"></div>

                    <div id="skelWrap" style="display:none">
                        <div class="product-grid">
                            <div class="skel skel-card"></div>
                            <div class="skel skel-card"></div>
                            <div class="skel skel-card"></div>
                            <div class="skel skel-card"></div>
                        </div>
                    </div>

                    <div class="product-grid" id="pGrid"></div>
                    <div class="nf-rows" id="nfRows" style="display:none;"></div>
                </div>
            </div>
        </main>
    </div>

    <!-- ═══ BOTTOM BAR ═══ -->
    @Html.Partial("~/Views/Parts/_ProductGroup.cshtml")

    <!-- ═══ Product Spec ═══ -->
    @Html.Partial("~/Views/Parts/_ProductSpec.cshtml")

    <!-- GUIDE -->
    <div class="guide" id="guide">
        <button class="guide-x" onclick="gEl('guide').style.display='none'"><i class="bi bi-x"></i></button>
        <h6><i class="bi bi-stars"></i> Guided Search Flow</h6>
        <p>
            <strong>①</strong> Vehicle Filter<br>
            <strong>②</strong> Search Parts (multi-mode)<br>
            <strong>③</strong> Sidebar Filters → results update instantly<br>
            <strong>④</strong> "See detail" → Spec popup<br>
            <strong>Bottom Bar</strong> → Switch product groups
        </p>
    </div>

    <!-- ═══════════ CART PANEL ════════════════ -->
    @Html.Partial("~/Views/Parts/_Cart.cshtml")

    <!-- ════════=ORDER SUMMARY MODAL ═════════════ -->
    @Html.Partial("~/Views/Parts/_OrderSummary.cshtml")



    <!-- TOASTS -->
    <div class="toasts" id="toastRack"></div>
    <script src="~/Scripts/jquery-3.4.1.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    <script src="@Url.Content("~/Scripts/sweetalert2.all.min.js")"></script>
    <script src="@Url.Content("~/Scripts/truscripts.js")"></script>
    <script src="@Url.Content("~/Scripts/productSearch.js")"></script>
    <script src="@Url.Content("~/Scripts/productTabLoader.js")"></script>
    <script>
    window.APP_SESSION = {
        cuscode : '@Session["cuscode"]',
        company : '@Session["company"]',
        username: '@Session["username"]'
    };
    </script>
    <script>
        $(document).ready(async function () {
            // โหลด dropdown
            await Promise.all([
                loadMasterMarketDefault(1),
                loadMasterMarketDefault(2),
                loadMaker()
                //loadMasterMarketDefault(3)
            ]);

            // ✅ ย้ายเข้ามาอยู่ใน ready ด้วย
            $('#yearTo').on('input', function () {
                const currentYear = new Date().getFullYear();
                if (this.value > currentYear) {
                    this.value = currentYear;
                }
            });
        });
    const urls = {
        getBrands: '@Url.Action("GetBrands", "Master")',
        getProductGroups: '@Url.Action("GetProductGroups", "Master")',
        getProductline: '@Url.Action("GetProductLines", "Master")',
        getMatchProductionGroup: '@Url.Action("getMatchProductionGroup", "Master")',
        getSalesmanAll: '@Url.Action("GetSalesmanAll", "Master")',
        getCustomerbySalesman: '@Url.Action("GetCustomerbySalesman", "Master")',
        getInfomantionCustomer: '@Url.Action("GetInfomantionCustomer", "Master")',
        getShiptoByCuscode: '@Url.Action("GetShiptoByCuscode", "Master")'
    };

    const urlsPro = {
        getProductToCartUrl: '@Url.Action("GetProductToCart", "Product")',
        addProductToCartUrl: '@Url.Action("AddProductToCart", "Product")',
        editProductToCart: '@Url.Action("EditProductToCart", "Product")',
        delProductToCart: '@Url.Action("DeleteProductToCart", "Product")'

    };
    const API_URLS = {
        getProductBySearchVio: '@Url.Action("GetProductBySearchVio", "Product")',
        getProductBySearchCatagory: '@Url.Action("GetProductBySearchCatagory", "Product")',
        getProductBySearchGlobal: '@Url.Action("GetProductBySearchGlobal", "Product")'
    };
    const TAB_API_URLS = {
        count: '@Url.Action("GetTabItemCountProduct", "Product")',
        description: '@Url.Action("GetTabDescription", "Product")',
        spec: '@Url.Action("GetTabSpec", "Product")',
        image: '@Url.Action("GetTabImage", "Product")',
        oem: '@Url.Action("GetTabOem", "Product")',
        competitor: '@Url.Action("GetTabCompetitor", "Product")',
        linkage: '@Url.Action("GetTabLinkage", "Product")'
        };

    </script>
</body>
</html>
