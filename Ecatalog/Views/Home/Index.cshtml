@*@{
        ViewBag.Title = "Home Page";
    }*@
@{
    Layout = null;
    var SessionUserType = ViewBag.UserType;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TRW Parts Pro — Smart Parts Finder</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@100..900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/Content/Site.css">
</head>
<body>
    @Html.Partial("~/Views/Parts/_Header.cshtml")

    <!-- MOBILE OVERLAY -->
    <div class="mob-overlay" id="mobOverlay"></div>

    <!-- MOBILE HAMBURGER -->
    <button class="mob-hamburger" id="mobHamburger" onclick="toggleMobSidebar()" aria-label="Toggle filter sidebar">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
    </button>

    <!-- ═══ APP LAYOUT ═══ -->
    <div class="app-layout">

        <!-- ════ SIDEBAR ════ -->
        @Html.Partial("~/Views/Parts/_Sidebar.cshtml")
        <!-- ════ MAIN ════ -->
        <main class="main-area" id="mainArea">
            <div class="main-content">

                <!-- Zone 1: Vehicle Summary + Clear Filter -->
                <div class="hz col-12" id="rz1">
                    <div class="rsh mb-2">
                        <span class="rsh-title col-8">Selected Vehicle</span>
                        <button class="clear-filter ms-auto" onclick="clearAllFilters()">
                            <i class="bi bi-x-circle"></i> Clear Filter
                        </button>
                    </div>
                    <div class="veh-pills" id="vehSummary">
                        <div class="veh-empty">
                            <i class="bi bi-car-front" style="font-size:1.1rem"></i>
                            <span>Select vehicle attributes in the left panel to filter parts</span>
                        </div>
                    </div>
                </div>

                <!-- Zone 2: Product Results -->
                <div class="hz" id="rz2">
                    <div class="rsh">
                        <span class="rsh-title">Product Results</span>
                        <span class="rcount" id="rcount">12 items</span>
                        <select class="sort-select ms-auto" id="sortSelect" onchange="sortProducts(this.value)">
                            <option value="carModel" selected>เรียงตาม: รุ่นรถ</option>
                            <option value="part">เรียงตาม: Part</option>
                            <option value="brand">เรียงตาม: ยี่ห้อสินค้า</option>
                            <option value="price-asc">ราคา: น้อย → มาก</option>
                            <option value="price-desc">ราคา: มาก → น้อย</option>
                            <option value="name">ชื่อ: A-Z</option>
                        </select>
                    </div>

                    <!-- Active Filter Chips -->
                    <div class="active-filters" id="activeFilters"></div>

                    <!-- Skeleton -->
                    <div id="skelWrap" style="display:none">
                        <div class="product-grid">
                            <div class="skel skel-card"></div>
                            <div class="skel skel-card"></div>
                            <div class="skel skel-card"></div>
                            <div class="skel skel-card"></div>
                        </div>
                    </div>

                    <!-- Product Grid -->
                    <div class="product-grid" id="pGrid"></div>

                    <!-- Netflix-style grouped rows (active when a specific group is selected) -->
                    <div class="nf-rows" id="nfRows" style="display:none;"></div>
                </div>

                <!-- §4 SPEC DRAWER removed from inline — see drawer below -->

            </div>
        </main>
    </div>

    <!-- ═══ BOTTOM BAR ═══ -->
    @Html.Partial("~/Views/Parts/_ProductGroup.cshtml")

    <!-- ═══ Product Spec ═══ -->
    @Html.Partial("~/Views/Parts/_ProductSpec.cshtml")

    <!-- GUIDE -->
    <div class="guide" id="guide">
        <button class="guide-x" onclick="gEl('guide').style.display='none'"><i class="bi bi-x"></i></button>
        <h6><i class="bi bi-stars"></i> Guided Search Flow</h6>
        <p>
            <strong>①</strong> Vehicle Filter<br>
            <strong>②</strong> Search Parts (multi-mode)<br>
            <strong>③</strong> Sidebar Filters → results update instantly<br>
            <strong>④</strong> "See detail" → Spec popup<br>
            <strong>Bottom Bar</strong> → Switch product groups
        </p>
    </div>

    <!-- ════════════════════════════════════════
         CART PANEL
    ════════════════════════════════════════ -->
    @Html.Partial("~/Views/Parts/_Cart.cshtml")

    <!-- ════════════════════════════════════════
         ORDER SUMMARY MODAL
    ════════════════════════════════════════ -->
    @Html.Partial("~/Views/Parts/_OrderSummary.cshtml")

    <!-- TOASTS -->
    <div class="toasts" id="toastRack"></div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="@Url.Content("~/Scripts/truscripts.js")"></script>

</body>
</html>