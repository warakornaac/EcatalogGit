@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="~/Content/fonts.css" rel="stylesheet">
    <link href="~/Content/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/Content/Login.css">
</head>
<body>
    <header class="header">
        <img src="~/Images/logo-white.png" style="width: 60px; height: 40px;">
    </header>
    <div class="page">
        <div class="left-panel">
            <div class="left-content">
                <p class="left-tagline">Smart Parts Finder</p>
                <h1 class="left-title">ค้นหาอะไหล่<span>ได้ทุกที่ ทุกเวลา</span></h1>
                <p class="left-desc">ระบบค้นหาอะไหล่รถยนต์อัจฉริยะ เชื่อมต่อกับคลังสินค้ากว่า 10,000 รายการ พร้อมระบบติดตามคำสั่งซื้อแบบ Real-time</p>
                <div class="feature-list">
                    <div class="feature-item"><i class="bi bi-check-circle-fill"></i> ค้นหาตามรุ่นรถ / รหัส OEM / แบรนด์</div>
                    <div class="feature-item"><i class="bi bi-check-circle-fill"></i> รองรับผู้ใช้หลายสาขา / หลาย User</div>
                    <div class="feature-item"><i class="bi bi-check-circle-fill"></i> มีสินค้าให้เลือกหลายแบรนด์</div>
                    <div class="feature-item"><i class="bi bi-check-circle-fill"></i> รองรับการสั่งซื้อออนไลน์</div>
                </div>
            </div>
        </div>
        <div class="right-panel">
            <div id="loginOverlay" style="display:none;position:absolute;inset:0;background:rgba(255,255,255,0.8);z-index:10;align-items:center;justify-content:center;flex-direction:column;gap:12px;border-radius:inherit">
                <div style="width:40px;height:40px;border:4px solid #eee;border-top-color:#e63946;border-radius:50%;animation:spin .7s linear infinite"></div>
                <div style="font-size:14px;color:#555;font-weight:500">กำลังเข้าสู่ระบบ...</div>
            </div>
            <div class="login-card">
                <div class="card-top">
                    <img src="~/Images/partspro.png" style="width: 250px; height: 60px; margin-bottom: 10px;">
                    <h2 class="card-title">เข้าสู่ระบบ</h2>
                    <p class="card-sub">TRW Parts Pro — Smart Parts Finder</p>
                </div>
                <form id="loginForm">
                    <div class="form-group" id="fgUser">
                        <label class="form-label" for="txtUsername">ชื่อผู้ใช้ / รหัสพนักงาน</label>
                        <div class="input-wrap">
                            <i class="bi bi-person input-icon"></i>
                            <input class="form-input" type="text" id="txtUsername" value="" placeholder="กรอกชื่อผู้ใช้หรือรหัสพนักงาน" autocomplete="username">
                        </div>
                        <p class="form-error" id="errUser">กรุณากรอกชื่อผู้ใช้</p>
                    </div>
                    <div class="form-group" id="fgPass">
                        <label class="form-label" for="txtPassword">รหัสผ่าน</label>
                        <div class="input-wrap">
                            <i class="bi bi-lock input-icon"></i>
                            <input class="form-input" type="password" id="txtPassword" placeholder="กรอกรหัสผ่าน" autocomplete="current-password">
                            <button type="button" class="eye-btn" onclick="togglePwd()" id="eyeBtn" aria-label="แสดง/ซ่อนรหัสผ่าน">
                                <i id="eyeIcon"></i>
                            </button>
                        </div>
                        <p class="form-error" id="errPass">กรุณากรอกรหัสผ่าน</p>
                    </div>
                    <button type="submit" class="btn-login" id="loginBtn">
                        <i class="bi bi-box-arrow-in-right"></i> เข้าสู่ระบบ
                    </button>
                </form>
            </div>
        </div>
    </div>
    <script src="~/Scripts/jquery-3.4.1.min.js"></script>
    <script src="@Url.Content("~/Scripts/sweetalert2.all.min.js")"></script>
    <script>
    document.getElementById("loginForm").addEventListener("submit", function(event) {
        event.preventDefault(); // ป้องกันไม่ให้หน้าเว็บรีเฟรชแบบปกติ
        AuthenUser(); // เรียกฟังก์ชั่นเข้าสู่ระบบ
    });
    function togglePwd() {
        const inp = document.getElementById('txtPassword');
        const ico = document.getElementById('eyeIcon');

        if (inp.type === 'password') {
            inp.type = 'text';
            ico.classList.replace('bi-eye', 'bi-eye-slash');
        } else {
            inp.type = 'password';
            ico.classList.replace('bi-eye-slash', 'bi-eye');
        }
    }
    function handleLogin(e) {
        e.preventDefault();
        const u = document.getElementById('username').value.trim();
        const p = document.getElementById('password').value.trim();
        const fg1 = document.getElementById('fgUser');
        const fg2 = document.getElementById('fgPass');
        let ok = true;
        fg1.classList.remove('has-error');
        fg2.classList.remove('has-error');
        if (!u) { fg1.classList.add('has-error'); ok = false; }
        if (!p) { fg2.classList.add('has-error'); ok = false; }
        if (!ok) return;
        const btn = document.getElementById('loginBtn');
        btn.innerHTML = '<i class="bi bi-arrow-repeat" style="animation:spin .7s linear infinite"></i> กำลังเข้าสู่ระบบ...';
        btn.disabled = true;
        setTimeout(() => {
            btn.innerHTML = '<i class="bi bi-check-lg"></i> เข้าสู่ระบบสำเร็จ';
            btn.style.background = '#1a9e52';
        }, 1400);
    }
    function doLogin(lat, lng) {
        $.ajax({
            url: '/Login/AuthenUser',
            method: 'POST',
            data: {
                Username: $('#Username').val(),
                Password: $('#Password').val(),
                Latitude: lat,
                Longitude: lng
            },
            success: function (res) { /* ... */ }
        });
    }
    async function AuthenUser() {
        const btn = document.getElementById("loginBtn");
        const Username = document.getElementById("txtUsername").value.trim();
        const Password = document.getElementById("txtPassword").value;

        // กันกดซ้ำ
        if (btn.disabled) return;

        // Validation
        document.getElementById("fgUser").classList.toggle("has-error", !Username);
        document.getElementById("fgPass").classList.toggle("has-error", !Password);

        if (!Username || !Password) return;

        // Lock ปุ่มทันที
        btn.disabled = true;
        btn.innerHTML = '<i class="bi bi-arrow-repeat" style="animation:spin .7s linear infinite"></i> กำลังเข้าสู่ระบบ...';
        document.getElementById('loginOverlay').style.display = 'flex';

        let lat = "";
        let lng = "";

        // ขอ location แบบไม่ทำให้ login ต้องรอ
        try {
            const pos = await new Promise((resolve, reject) =>
                navigator.geolocation.getCurrentPosition(
                    resolve,
                    reject,
                    { timeout: 1000, maximumAge: 300000 }
                )
            );

            lat = pos.coords.latitude;
            lng = pos.coords.longitude;
        } catch (e) {
            // ไม่ได้ location ก็ login ต่อ
        }

        try {
            const response = await fetch('@Url.Action("AuthenUser","Login")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    Username: Username,
                    Password: Password,
                    Latitude: lat,
                    Longitude: lng
                })
            });

            const res = await response.json();

            if (res.IsSuccess) {
                btn.innerHTML = '<i class="bi bi-check-lg"></i> เข้าสู่ระบบสำเร็จ';
                window.location.href = '@Url.Action("Index","Home")';
                document.getElementById('loginOverlay').style.display = 'none';
            } else {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-box-arrow-in-right"></i> เข้าสู่ระบบ';
                document.getElementById('loginOverlay').style.display = 'none';
                Swal.fire({
                    icon: 'warning',
                    title: 'ไม่สำเร็จ',
                    text: res.Message
                });
            }

        } catch (e) {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-box-arrow-in-right"></i> เข้าสู่ระบบ';

            Swal.fire({
                icon: 'error',
                title: 'เกิดข้อผิดพลาด',
                text: e.message || "System Error"
            });
        }
    }
</script>
</body>
</html>