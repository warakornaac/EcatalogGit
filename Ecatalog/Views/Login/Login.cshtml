@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@100..900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/Content/Login.css">
</head>
<body>

    <header class="header">
        <div class="brand-icon"><i class="bi bi-tools"></i></div>
        <div class="brand">TRW Parts Pro</div>
    </header>

    <div class="page">
        <!-- LEFT -->
        <div class="left-panel">
            <div class="left-content">
                <p class="left-tagline">Smart Parts Finder</p>
                <h1 class="left-title">ค้นหาอะไหล่<span>ได้ทุกที่ ทุกเวลา</span></h1>
                <p class="left-desc">ระบบค้นหาอะไหล่รถยนต์อัจฉริยะ เชื่อมต่อกับคลังสินค้ากว่า 10,000 รายการ พร้อมระบบติดตามคำสั่งซื้อแบบ Real-time</p>
                <div class="feature-list">
                    <div class="feature-item"><i class="bi bi-check-circle-fill"></i> ค้นหาตามรุ่นรถ / รหัส OEM / แบรนด์</div>
                    <div class="feature-item"><i class="bi bi-check-circle-fill"></i> ติดตามสถานะสินค้าจองล่วงหน้า (BO)</div>
                    <div class="feature-item"><i class="bi bi-check-circle-fill"></i> ออกใบเสนอราคา / ใบสั่งซื้อ ออนไลน์</div>
                    <div class="feature-item"><i class="bi bi-check-circle-fill"></i> รองรับผู้ใช้หลายสาขา / หลาย User</div>
                </div>
            </div>
        </div>

        <!-- RIGHT -->
        <div class="right-panel">
            <div class="login-card">
                <div class="card-top">
                    <img src="~/Images/logotru.png" style="width: 75px; height: 60px; margin-bottom: 20px;">
                    <h2 class="card-title">เข้าสู่ระบบ</h2>
                    <p class="card-sub">TRW Parts Pro — Smart Parts Finder</p>
                </div>

                <form id="loginForm" onsubmit="handleLogin(event)" novalidate>
                    <div class="form-group" id="fgUser">
                        <label class="form-label" for="username">ชื่อผู้ใช้ / รหัสพนักงาน</label>
                        <div class="input-wrap">
                            <i class="bi bi-person input-icon"></i>
                            <input class="form-input" type="text" id="username" placeholder="กรอกชื่อผู้ใช้หรือรหัสพนักงาน" autocomplete="username">
                        </div>
                        <p class="form-error" id="errUser">กรุณากรอกชื่อผู้ใช้</p>
                    </div>

                    <div class="form-group" id="fgPass">
                        <label class="form-label" for="password">รหัสผ่าน</label>
                        <div class="input-wrap">
                            <i class="bi bi-lock input-icon"></i>
                            <input class="form-input" type="password" id="password" placeholder="กรอกรหัสผ่าน" autocomplete="current-password">
                            <button type="button" class="eye-btn" onclick="togglePwd()" id="eyeBtn" aria-label="แสดง/ซ่อนรหัสผ่าน">
                                <i class="bi bi-eye" id="eyeIcon"></i>
                            </button>
                        </div>
                        <p class="form-error" id="errPass">กรุณากรอกรหัสผ่าน</p>
                    </div>

                    <!-- <div class="options-row">
                      <label class="remember">
                        <input type="checkbox" id="remember"> จดจำการเข้าสู่ระบบ
                      </label>
                      <a href="#" class="forgot">ลืมรหัสผ่าน?</a>
                    </div> -->

                    <button type="submit" class="btn-login" id="loginBtn">
                        <i class="bi bi-box-arrow-in-right"></i> เข้าสู่ระบบ
                    </button>
                </form>

                <!-- <div class="divider">หรือ</div>

                <button class="btn-guest" onclick="handleGuest()">
                  <i class="bi bi-person-dash"></i> เข้าชมในฐานะผู้เยี่ยมชม
                </button> -->

                @*<div class="card-footer">
                    มีปัญหาในการเข้าสู่ระบบ? <a href="#">ติดต่อผู้ดูแลระบบ</a>
                </div>*@

            </div>

        </div>
    </div>

    <script>

    document.getElementById("loginBtn").onclick = function () {
        window.location.href = '@Url.Action("Index","Home")';
    };
        function togglePwd() {
            const inp = document.getElementById('password');
            const ico = document.getElementById('eyeIcon');
            if (inp.type === 'password') { inp.type = 'text'; ico.className = 'bi bi-eye-slash'; }
            else { inp.type = 'password'; ico.className = 'bi bi-eye'; }
        }

        function handleLogin(e) {
            e.preventDefault();
            const u = document.getElementById('username').value.trim();
            const p = document.getElementById('password').value.trim();
            const fg1 = document.getElementById('fgUser');
            const fg2 = document.getElementById('fgPass');
            let ok = true;
            fg1.classList.remove('has-error');
            fg2.classList.remove('has-error');
            if (!u) { fg1.classList.add('has-error'); ok = false; }
            if (!p) { fg2.classList.add('has-error'); ok = false; }
            if (!ok) return;
            const btn = document.getElementById('loginBtn');
            btn.innerHTML = '<i class="bi bi-arrow-repeat" style="animation:spin .7s linear infinite"></i> กำลังเข้าสู่ระบบ...';
            btn.disabled = true;
            setTimeout(() => {
                btn.innerHTML = '<i class="bi bi-check-lg"></i> เข้าสู่ระบบสำเร็จ';
                btn.style.background = '#1a9e52';
            }, 1400);
        }

        function handleGuest() {
            const btn = event.currentTarget;
            btn.innerHTML = '<i class="bi bi-arrow-repeat" style="animation:spin .7s linear infinite"></i> กำลังโหลด...';
            setTimeout(() => { btn.innerHTML = '<i class="bi bi-person-dash"></i> เข้าชมในฐานะผู้เยี่ยมชม'; }, 1200);
        }
    </script>
</body>
</html>
