    <!--// =========================================
// Global
// =========================================

// =========================================
// GLOBAL
// =========================================
let GROUPS = [];
let activeGroup = '';

// shorthand getElementById
function gEl(id) {
    return document.getElementById(id);
}

// =========================================
// LOAD PRODUCT GROUP
// =========================================
function productGroup(com , cuscod) {

    console.log("LOAD PRODUCT GROUP");
    console.log("COM :", com);
    console.log("CUSCOD :", cuscod);

    $.ajax({

        url: '@Url.Action("GetProductGroup", "TruAutoParts")',

        type: "POST",

        dataType: "json",

        data: {
            com: com,
            cuscod: cuscod
        },

        success: function (data) {

            console.log("API DATA :", data);

            // เก็บข้อมูล
            GROUPS = data || [];

            // render bottom bar
            renderBB();

            // render dropdown
            renderDropdown();

        },

        error: function (xhr, status, err) {

            console.log("AJAX ERROR");
            console.log(xhr);
            console.log(status);
            console.log(err);

        }

    });

}

// =========================================
// RENDER DROPDOWN
// =========================================
function renderDropdown() {

    const select = $("#productgroup");

    if (!select.length) return;

    select.empty();

    select.append(
        $("<option>")
            .val("")
            .text("หมวดสินค้า(Product Group)")
    );

    GROUPS.forEach(function (item) {

        select.append(
            $("<option>")
                .val(item.ProductGroup)
                .text(item.ProductGroup)
        );

    });

    $('.selectpicker').selectpicker('refresh');

}

// =========================================
// RENDER BOTTOM BAR
// =========================================
function renderBB() {

    const container = gEl('bbScroll');

    if (!container) {
        console.log("NOT FOUND #bbScroll");
        return;
    }

    console.log("GROUPS :", GROUPS);
    console.log("TOTAL :", GROUPS.length);

    // ไม่มีข้อมูล
    if (!GROUPS || GROUPS.length === 0) {

        container.innerHTML = `
            <div class="px-3 py-2 text-muted">
                ไม่มีข้อมูลสินค้า
            </div>
        `;

        return;
    }

    // render item
    container.innerHTML = GROUPS.map(g => `

        <div
            class="mr-5 bb-item ${g.ProductGroup === activeGroup ? 'active' : ''}"
            onclick="selectGroup('${g.ProductGroup}')"
        >

            <i class="fa fa-gears"></i>

            <span class="bb-label">
                ${g.ProductGroup}
            </span>

        </div>

    `).join('');

}

// =========================================
// SCROLL BOTTOM BAR
// =========================================
function scrollBB(dx) {

    const el = gEl('bbScroll');

    if (!el) return;

    el.scrollBy({
        left: dx,
        behavior: 'smooth'
    });

}

// =========================================
// SELECT GROUP
// =========================================
function selectGroup(groupName) {

    activeGroup = groupName;

    document.querySelectorAll('.bb-item').forEach((item, index) => {

        item.classList.toggle(
            'active',
            GROUPS[index]?.ProductGroup === groupName
        );

    });

    // scroll active item เข้า view
    const activeItem = document.querySelector('.bb-item.active');

    if (activeItem) {

        activeItem.scrollIntoView({
            behavior: 'smooth',
            inline: 'center',
            block: 'nearest'
        });

    }

    console.log("SELECTED :", groupName);

    // TODO:
    // loadProduct(groupName);

}

// =========================================
// PAGE LOAD
// =========================================
$(document).ready(function () {

    productGroup();

});

</script>-->