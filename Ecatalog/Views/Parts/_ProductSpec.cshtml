<!-- ═══ DESKTOP SPEC MODAL (≥992 px) ═══ -->
<div class="spec-modal-backdrop" id="specModalBackdrop" onclick="closeSpecModal(event)">
    <div class="spec-modal" role="dialog" aria-modal="true" aria-label="Product specification">
        <div class="spec-modal-header">
            <span style="font-size:13px;font-weight:600;color:var(--text-2)">Product Specification</span>
            <button class="spec-modal-close" onclick="closeSpecModal()" aria-label="Close"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="spec-modal-body" id="specModalContent"></div>
    </div>
</div>

<!-- ═══ MOBILE SPEC DRAWER (PartHub-style, <992 px) ═══ -->
<div class="drawer-overlay" id="drawerOverlay" onclick="closeDrawer()"></div>
<div class="spec-drawer" id="specDrawer">
    <div class="dr-header">
        <button class="dr-close" onclick="closeDrawer()"><i class="bi bi-x-lg"></i></button>
        <div>
            <div class="dr-title" id="drTitle">Product Specification</div>
            <div class="dr-code-lbl" id="drCode">—</div>
        </div>
    </div>

    <div class="dr-hero">
        <img id="drImg" src="" alt=""
             style="display:none;width:120px;height:120px;object-fit:contain;
            background:var(--surface);border-radius:var(--r);
            padding:8px;flex-shrink:0;box-shadow:var(--sh-sm)">
        <div id="drImgPh" style="display:flex;width:120px;height:120px;align-items:center;justify-content:center;background:var(--surface-2);color:var(--text-3);font-size:28px;border-radius:8px;flex-shrink:0">
            <i class="bi bi-image"></i>
        </div>
        <div class="dr-meta">
            <div class="dm-brand" id="drBrand">—</div>
            <h3 id="drName">—</h3>
            <div class="dm-code" id="drCode2">—</div>
            <div class="dr-price" id="drPrice">$0.00</div>
            <div class="dr-add-row">
                <input type="number" class="dr-qty" id="drQty" value="1" min="1" max="99">
                <button class="dr-add-btn" id="drAddBtn" onclick="addCartFromDrawer(event)">
                    <i class="bi bi-cart-plus"></i> Add to Cart
                </button>
            </div>
        </div>
    </div>

    <div class="dr-tabs">
        <button class="drtab active" onclick="switchDrTab(this,'desc')"><i class="bi bi-file-text"></i> Description </button>
        <button class="drtab" onclick="switchDrTab(this,'spec')"><i class="bi bi-rulers"></i> Spec </button>
        <button class="drtab" onclick="switchDrTab(this,'imgs')"><i class="bi bi-images"></i> Image </button>
        <button class="drtab" onclick="switchDrTab(this,'oem')"><i class="bi bi-upc"></i> OEM </button>
        <button class="drtab" onclick="switchDrTab(this,'comp')"><i class="bi bi-diagram-2"></i> Competitor </button>
        <button class="drtab" onclick="switchDrTab(this,'veh')"><i class="bi bi-car-front"></i> Vehicle </button>
    </div>

    <div class="dr-content">
        <!-- desc pane — คง static fields ไว้ แต่ API จะ override drDescFull -->
        <div class="drpane active" id="dp-desc">
            <p id="drDescFull" style="font-size:13.5px;line-height:1.8;color:var(--text-2);margin-bottom:14px">—</p>
            <div class="row g-2">
                <div class="col-6 col-sm-3">
                    <div style="background:var(--surface-2);border-radius:var(--r);padding:10px;text-align:center;border:1px solid var(--border)">
                        <div style="font-size:10px;color:var(--text-3);font-weight:600;text-transform:uppercase;letter-spacing:.5px">Category</div>
                        <div style="font-size:12.5px;font-weight:700;color:var(--text);margin-top:3px" id="drCat">—</div>
                    </div>
                </div>
                <div class="col-6 col-sm-3">
                    <div style="background:var(--surface-2);border-radius:var(--r);padding:10px;text-align:center;border:1px solid var(--border)">
                        <div style="font-size:10px;color:var(--text-3);font-weight:600;text-transform:uppercase;letter-spacing:.5px">Brand</div>
                        <div style="font-size:12.5px;font-weight:700;color:var(--primary);margin-top:3px" id="drBrandCard">—</div>
                    </div>
                </div>
                <div class="col-6 col-sm-3">
                    <div style="background:var(--surface-2);border-radius:var(--r);padding:10px;text-align:center;border:1px solid var(--border)">
                        <div style="font-size:10px;color:var(--text-3);font-weight:600;text-transform:uppercase;letter-spacing:.5px">Part No.</div>
                        <div style="font-size:12.5px;font-weight:700;color:var(--text);margin-top:3px" id="drPN">—</div>
                    </div>
                </div>
                <div class="col-6 col-sm-3" id="drBoRow" style="display:none">
                    <div style="background:#fff3cd;border-radius:var(--r);padding:10px;text-align:center;border:1px solid #ffc107">
                        <div style="font-size:11px;font-weight:700;color:#856404">
                            <i class="bi bi-hourglass-split"></i> Back Order
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ✅ pane อื่นว่างหมด — API จะเติม -->
        <div class="drpane" id="dp-spec"></div>
        <div class="drpane" id="dp-imgs"></div>
        <div class="drpane" id="dp-oem"></div>
        <div class="drpane" id="dp-comp"></div>
        <div class="drpane" id="dp-veh"></div>
    </div>
</div>