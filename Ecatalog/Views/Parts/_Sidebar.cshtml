@{
    // ✅ แปลงเป็น string ให้ชัดเจนตั้งแต่ต้น กัน dynamic comparison พัง
    var SessionUserType = ViewBag.UserType?.ToString() ?? "";
    var sessionSlmCode = Session["slmcode"]?.ToString() ?? "";
    var sessionCusCode = Session["cusCode"]?.ToString() ?? "";
}
<style>
    .sinput-wrap {
        position: relative;
    }

    .ecac-dropdown {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 2000;
        max-height: 320px;
        overflow-y: auto;
        margin-top: 2px;
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 6px;
        box-shadow: 0 6px 16px rgba(0,0,0,.15);
    }

        .ecac-dropdown.open {
            display: block;
        }

    .ecac-item {
        padding: 6px 10px;
        cursor: pointer;
        border-bottom: 1px solid #f1f1f1;
    }

        .ecac-item:hover, .ecac-item.active {
            background: #f3f0ff;
        }

    .ecac-code {
        font-weight: 700;
        font-size: 12px;
    }

    .ecac-des {
        font-size: 11px;
        color: #555;
    }

    .ecac-oem {
        font-size: 10px;
        color: #888;
    }

    .ecac-empty {
        padding: 8px 10px;
        font-size: 12px;
        color: #888;
    }

    .ecac-dropdown mark {
        background: #ffe58f;
        padding: 0;
    }
</style>

<div id="appConfig"
     data-usertype="@SessionUserType"
     data-slmcode="@sessionSlmCode"
     data-cuscode="@sessionCusCode">
</div>

<!-- ════ SIDEBAR ════ -->
<aside class="sidebar" id="sidebar" role="complementary" aria-label="Filter sidebar">
    <div class="sidebar-inner mb-7">
        <div class="sb-sc-bar">
            <div class="sb-sc-row">
                <div class="sb-sc-field">
                    <label class="sb-sc-label" for="salesmanId">Salesman</label>
                    <select class="sb-select sb-select-sm select2-target" id="salesmanId">
                        <option value="">-- เลือก Salesman --</option>
                    </select>
                </div>
                <div class="sb-sc-field">
                    <label class="sb-sc-label" for="customerId">Customer</label>
                    <select class="sb-select sb-select-sm select2-target" id="customerId">
                        <option value="">-- เลือก Customer --</option>
                    </select>
                </div>
            </div>
            <div class="company-group" role="group" aria-label="Company">
                <button class="company-btn" data-company="AAC" onclick="toggleCompany(this)" aria-pressed="false">AAC</button>
                <button class="company-btn" data-company="TAC" onclick="toggleCompany(this)" aria-pressed="false">TAC</button>
                <button class="company-btn" data-company="OMP" onclick="toggleCompany(this)" aria-pressed="false">OMP</button>
                <button class="company-btn" data-company="AGS" onclick="toggleCompany(this)" aria-pressed="false">AGS</button>
            </div>
        </div>

        <div class="sec-hd" aria-expanded="true" onclick="toggleSec(this, 'vfBody'); activateSec(1)">
            <span class="sec-title">Vehicle Filter</span>
            <i class="bi bi-chevron-down sec-chevron"></i>
        </div>
        <div class="collapse show" id="vfBody">
            <div class="filter-body">
                <div class="mb-2">
                    <div class="flabel">Market Segment</div>
                    <select class="fselect" id="marketsegId" 
                            @*onchange="loadMaker();*@
                            loadModelRange();">
                        <option value="">— Select Market —</option>
                    </select>
                </div>
                <div class="mb-2">
                    <div class="flabel">Vehicle Segment</div>
                    <select class="fselect" id="segmentId" 
                            @*onchange="loadMaker();*@
                            loadModelRange();">
                        <option value="">— Select Segment —</option>
                    </select>
                </div>
                <div class="mb-2">
                    <div class="flabel">Maker</div>
                    <select class="fselect" id="makerId" 
                            @*onchange="loadModelRange();"*@
                            >
                        <option value="">— Select Maker —</option>
                    </select>
                </div>
                <div class="mb-2">
                    <div class="flabel">Model Range</div>
                    <select class="fselect" id="rangeId" 
                            @*onchange="loadBody();*@
                             loadEngine();">
                        <option value="">— Select Range —</option>
                    </select>
                </div>
                <div class="mb-2">
                    <div class="flabel">Model Body</div>
                    <select class="fselect" id="bodyId" onchange="loadEngine();" disabled>
                        <option value="">— Select Body —</option>
                    </select>
                </div>
                <div class="mb-2">
                    <div class="flabel">Engine</div>
                    <select class="fselect" id="engineId" onchange="updateVehSummary()" disabled>
                        <option value="">— Select Engine —</option>
                    </select>
                </div>
                <div class="mb-2">
                    <div class="flabel">Year Range</div>
                    <div class="yr-range">
                        <div class="yp-wrap">
                            <input type="text" id="yearFrom" class="yp-input" placeholder="From" readonly disabled autocomplete="off">
                            <div class="yp-panel" id="ypPanelFrom"></div>
                        </div>
                        <span>–</span>
                        <div class="yp-wrap">
                            <input type="text" id="yearTo" class="yp-input" placeholder="To" readonly disabled autocomplete="off">
                            <div class="yp-panel" id="ypPanelTo"></div>
                        </div>
                    </div>
                </div>
                <div class="mb-1">
                    <div class="flabel">Drive System</div>
                    <select class="fselect" id="driveId" onchange="updateVehSummary()" disabled>
                        <option value="">— Select Drive —</option>
                        <option value="FWD">FWD</option>
                        <option value="RWD">RWD</option>
                        <option value="AWD">4WD / AWD</option>
                        <option value="NA">NA</option>
                    </select>
                </div>
                <div class="ftags" id="vfTags"></div>
                
            </div>
        </div>

        <div class="collapse show" id="spBody">
            <div class="filter-body">
                <div class="flabel mb-1">Search Mode <span style="color:var(--purple);font-size:9px;font-weight:700">(multi-select)</span></div>
                <div class="smode-group" id="smodeGroup">
                    <label class="smode-btn active" data-mode="description" onclick="toggleMode(this)">
                        <i class="bi bi-card-text"></i> Description
                    </label>
                    <label class="smode-btn" data-mode="oe" onclick="toggleMode(this)">
                        <i class="bi bi-upc-scan"></i> OE
                    </label>
                    <label class="smode-btn" data-mode="competitor" onclick="toggleMode(this)">
                        <i class="bi bi-arrows-collapse"></i> Competitor
                    </label>
                </div>
            <div class="sinput-wrap mt-1" id="sidebarSearchWrap">
                <input type="text" id="txtSearchField" placeholder="Type part name or code…"
                       oninput="syncSearch('sidebar'); document.getElementById('btnClearSearch').style.display = this.value ? 'flex' : 'none';"
                       autocomplete="off" aria-autocomplete="list" aria-expanded="false">
                <button id="btnClearSearch"
                        style="display:none;position:absolute;right:28px;top:50%;transform:translateY(-50%);background:none;border:none;padding:0;cursor:pointer;color:#aaa;font-size:14px;line-height:1;align-items:center;"
                        onclick="clearSearchField()">
                    <i class="bi bi-x-circle-fill"></i>
                </button>
                <i class="bi bi-search"></i>
                <div class="ecac-dropdown" id="ecAcDropdown" role="listbox"></div>
            </div>
                
                <button class="search-btn" id="btnSearchProductVio" onclick="(async () => {
                    if (!_requireSalesmanAndCustomer()) return;

                    const hasText = $('#txtSearchField').val().trim();

                    if (hasText) {
                        loadSearchProductField();
                    } else {
                        await loadSearchProductVio();
                    }
                    })();">
                    <i class="bi bi-lightning-charge-fill"></i> Search
                </button>

            </div>
        </div>

        <div class="collapse show" id="sfBody">
                <div class="filter-body">
                    
                    <div class="flabel">Fitting (ตำแหน่งติดตั้ง)</div>
                    <div class="fit-grid" id="fitGrid">
                        <div class="fit-chip" onclick="toggleFit(this,'หน้า')">หน้า</div>
                        <div class="fit-chip" onclick="toggleFit(this,'หลัง')">หลัง</div>
                        <div class="fit-chip" onclick="toggleFit(this,'ซ้าย')">ซ้าย</div>
                        <div class="fit-chip" onclick="toggleFit(this,'ขวา')">ขวา</div>
                        <div class="fit-chip" onclick="toggleFit(this,'บน')">บน</div>
                        <div class="fit-chip" onclick="toggleFit(this,'ล่าง')">ล่าง</div>
                    </div>

                </div>
            </div>
    </div>
</aside>

<script>

    //get master
async function loadMasterMarketDefault(moduleId) {
    let selectId = moduleId == 2 ? "segmentId" : "marketsegId";
    let selectDefaultText = moduleId == 2 ? "Select Segment" : "Select Market";
    let defaultKeyword = moduleId == 2 ? "PASSENGER" : "JAPAN";

    try {
        const params = new URLSearchParams({ moduleId });
        const response = await fetch(`@Url.Action("GetMarketCar", "Master")?${params}`, { method: 'GET' });
        const result = await response.json();
        const ddl = $("#" + selectId);
        ddl.empty();
        ddl.append('<option value="ALL">— ' + selectDefaultText + ' —</option>');
        if (result.IsSuccess && result.Data) {
            result.Data.forEach(item => {
                ddl.append(`<option value="${item.Id}">${item.Name}</option>`);
            });
        }

        // ✅ set default ทันทีหลัง populate เสมอ
        const defaultOpt = Array.from(ddl[0].options)
            .find(o => o.text.trim().toUpperCase().includes(defaultKeyword));
        if (defaultOpt) ddl.val(defaultOpt.value);

    } catch (error) {
        console.error(error);
    }
}
async function loadMaker(_skipReset = false) {
    try {
        const marketSegmentId = $("#marketsegId").val();
        const vehicleSegmentId = $("#segmentId").val();
        const params = new URLSearchParams({ marketSegmentId, vehicleSegmentId });
        const response = await fetch(`@Url.Action("GetMakerCar", "Master")?${params}`, { method: 'GET' });
        const result = await response.json();
        const ddl = $("#makerId");
        ddl.empty();
        ddl.append('<option value="">— Select Maker —</option>');
        if (result.IsSuccess && result.Data) {
            result.Data.forEach((item, index) => {
                ddl.append(`<option value="${item.Id}">${item.Name}</option>`);
                if (index === 4) {
                    ddl.append('<option disabled>──────────────────────────</option>');
                }
            });
        }
    } catch (error) {
        console.error(error);
    } finally {
        // ✅ ถ้าเป็น init pass → ไม่ reset makerId
        if (!_skipReset) {
            $("#makerId").val('');
        }
        updateVehSummary();
    }
}
async function loadModelRange(_isInit = false) {
    try {
        // ✅ ถ้าเป็น init → ไม่ reset body/engine
        if (!_isInit) {
            $("#bodyId").empty().append('<option value="">— Select Body —</option>');
            $("#engineId").empty().append('<option value="">— Select Engine —</option>');
        }

        const marketSegmentId = $("#marketsegId").val();
        const segmentId = $("#segmentId").val();
        const makerId = $("#makerId").val();
        const allThreeSelected = marketSegmentId && segmentId && makerId;

        // ✅ ถ้าเป็น init → ไม่ disable fields
        if (!_isInit) {
            ['rangeId', 'bodyId', 'engineId', 'driveId'].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.disabled = !allThreeSelected;
            });
            setYearRangeDisabled(!allThreeSelected);
        }

        const params = new URLSearchParams({ marketSegmentId, segmentId, makerId });
        const response = await fetch(`@Url.Action("GetModelRange", "Master")?${params}`, { method: 'GET' });
        const result = await response.json();

        const ddl = $("#rangeId");
        ddl.empty().append('<option value="ALL">— Select Range —</option>');
        if (result.IsSuccess && result.Data) {
            result.Data.forEach(item => {
                ddl.append(`<option value="${item.Id}" data-modelrange="${item.ModelRangeId || ''}" data-market="${item.MarketSegmentId}">${item.Model}</option>`);
            });
        }
    } catch (error) {
        console.error(error);
    } finally {
        updateVehSummary();
    }
}
    async function loadBody() {
        try {
            $("#engineId").empty().append('<option value="">— Select Engine —</option>');
            const marketSegmentId = $("#rangeId option:selected").data("market");
            const segmentId = $("#segmentId").val();
            const makerId = $("#makerId").val();
            const rangeId = $("#rangeId").val();
            const modelRangeId = $("#rangeId option:selected").data("modelrange");
            const params = new URLSearchParams({ marketSegmentId, segmentId, makerId, rangeId, modelRangeId });
            const response = await fetch(`@Url.Action("GetBody", "Master")?${params}`, { method: 'GET' });
            const result = await response.json();

            const ddl = $("#bodyId");
            ddl.empty().append('<option value="">— Select Body —</option>');
            if (result.IsSuccess && result.Data) {
                result.Data.forEach(item => {
                    ddl.append(`<option value="${item.id}">${item.body}</option>`);
                });
            }
        } catch (error) {
            console.error(error);
            Swal.fire({ icon: 'error', title: 'Load Body Failed', text: error.message });
        } finally {
            updateVehSummary();
            await loadEngine(); // ✅ โหลด Engine ทันทีหลัง Body โหลดเสร็จ
        }
    }
    async function loadEngine() {
        try {
            const marketSegmentId = $("#marketsegId").val();
            const segmentId = $("#segmentId").val();
            const makerId = $("#makerId").val();
            const rangeId = $("#rangeId").val();
            const bodyId = $("#bodyId").val(); // optional
            const modelRangeId = $("#rangeId option:selected").data("modelrange") || ''; // optional

            // ✅ บังคับแค่ครบ 3 ตัวแรก + rangeId เท่านั้น
            if (!marketSegmentId || !segmentId || !makerId || !rangeId) {
                $("#engineId").empty().append('<option value="">— Select Engine —</option>');
                updateVehSummary();
                return;
            }

            const params = new URLSearchParams({ marketSegmentId, segmentId, makerId, rangeId, modelRangeId });
            if (bodyId) params.append('bodyId', bodyId); // ✅ ส่ง bodyId ถ้ามี เพื่อ filter เพิ่มเติม

            const response = await fetch(`@Url.Action("GetEngine", "Master")?${params}`, { method: 'GET' });
            const result = await response.json();

            const ddl = $("#engineId");
            ddl.empty().append('<option value="">— Select Engine —</option>');
            if (result.IsSuccess && result.Data) {
                result.Data.forEach(item => {
                    if (item.modelRangeId == modelRangeId) {
                        ddl.append(`<option value="${item.id}">${item.engineType}</option>`);
                    }
                });
            }
        } catch (error) {
            console.error(error);
            Swal.fire({ icon: 'error', title: 'Load Engine Failed', text: error.message });
        } finally {
            updateVehSummary();
        }
    }

    function getSearchCatagoryObject() {
        _syncSessionFromUI();

        const activeGroupIds = $(".bb-item.active")
            .map(function () { return $(this).data("id"); })
            .get()
            .filter(id => id !== '0' && id !== 0)
            .map(id => String(id));

        const axisMap = { 'หน้า': 'FR', 'หลัง': 'RR', 'กลาง': 'MID', 'เครื่องยนต์': 'ENGINE' };
        const sideMap = { 'ซ้าย': 'LH', 'ขวา': 'RH', 'กลาง': 'CENTER' };
        const levelMap = { 'บน': 'UPPER', 'ล่าง': 'LOWER' };
        const dirMap = { 'ใน': 'INNER', 'นอก': 'OUTER' };

        const fits = [...fitState];
        const fittingFilter = [...new Set([
            ...fits.map(f => axisMap[f]).filter(Boolean),
            ...fits.map(f => sideMap[f]).filter(Boolean),
            ...fits.map(f => levelMap[f]).filter(Boolean),
            ...fits.map(f => dirMap[f]).filter(Boolean),
        ])];

        const checkedLineNames = Object.keys(chkState.pl);
        const checkedBrandNames = Object.keys(chkState.br);

        const checkedLineIds = checkedLineNames
            .map(name => chkState.pl[name])
            .filter(id => id !== null && id !== undefined && id !== '');

        const checkedBrandIds = checkedBrandNames
            .map(name => chkState.br[name])
            .filter(id => id !== null && id !== undefined && id !== '');

        const companies = typeof getActiveCompanies === 'function' ? getActiveCompanies() : [];

        // ✅ อ่านค่าจาก dropdown ตามปกติ
        // ถ้า user ยังไม่เลือก (ค่าว่างหรือ ALL) ให้ใช้ default
        const marketSegmentId = $("#marketsegId").val() || "";
        const segmentId = $("#segmentId").val() || "";
        const makerId = $("#makerId").val() || "";
        const rangeId = ($("#rangeId").val() === "ALL" ? "" : $("#rangeId").val()) || "";

        return {
            productGroupId: activeGroupIds,
            productLineId: checkedLineIds,
            brandId: checkedBrandIds,
            fittingFilter: fittingFilter,
            marketSegmentId: marketSegmentId,
            segmentId: segmentId,
            makerId: makerId,
            rangeId: rangeId,
            bodyId: $("#bodyId").val() || "",
            engineId: $("#engineId").val() || "",
            yearFrom: $("#yearFrom").val() || "",
            yearTo: $("#yearTo").val() || "",
            driveType: $("#driveId").val() || "",
            SlmCode: $("#salesmanId").val() || window.APP_SESSION?.slmcode || "",
            CusCode: $("#customerId").val() || window.APP_SESSION?.cuscode || "",
            Company: companies
        };
    }
    //send params send to controller searchByCategory
    async function searchProductByCategory() {
        if (!_requireSalesmanAndCustomer()) return;

        try {
            const filters = getSearchCatagoryObject();

        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 120000); // 120s

        const response = await fetch(
            '@Url.Action("GetProductBySearchCatagory","Product")',
            {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(filters),
                signal: controller.signal
            });

        clearTimeout(timeoutId);

        const result = await response.json();
        if (!response.ok) throw new Error(result.Message || "API Error");

        if (result.IsSuccess) {
            //console.log('result.Data length:', result.Data?.length); // ✅
            _setBaseProducts(result.Data, 'category', false, true);  // ← set _lastSearchType = 'category'
            //console.log('_lastSearchType after set:', _lastSearchType); // ✅

            // Rebuild DOM ของ Sidebar ใหม่ทั้งหมดตาม BASE_PRODUCTS ชุดใหม่
            _rebuildSidebarFromProducts();

            // กรองข้อมูล นำไป Render ตาราง และอัปเดต Badge/Visibility ของ Sidebar (_updateSidebar)
            _applyFiltersAndRender();

            gEl('nfRows')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } else {
            Swal.fire({
                icon: 'warning',
                title: 'ค้นหาไม่สำเร็จ',
                text: 'ระบบใช้เวลานานกว่าปกติ กรุณาลองใหม่อีกครั้ง'
            });
        }
    } catch (ex) {
        console.error("searchProductByCategory Error:", ex);
        const isTimeout = ex.name === 'AbortError';
        Swal.fire({
            icon: 'error',
            title: isTimeout ? 'หมดเวลาค้นหา' : 'เกิดข้อผิดพลาด',
            text: isTimeout
                ? 'ระบบค้นหาช้ากว่าปกติ กรุณาลองใหม่อีกครั้ง'
                : (ex.message || "System Error")
        });
    } finally {
        hideSkel();
    }
}
    //get value text, checkbox
    async function getSearchFieldObject() {
        _syncSessionFromUI();
        const companies = typeof getActiveCompanies === 'function' ? getActiveCompanies() : [];
        const request = {
            searchText: $("#txtSearchField").val().trim(),
            searchFields: $(".smode-btn.active").map(function () {
                return $(this).data("mode");
            }).get(),
            marketSegmentId: $("#marketsegId").val() || "",
            segmentId: $("#segmentId").val() || "",
            makerId: $("#makerId").val() || "",
            rangeId: $("#rangeId").val() || "",
            bodyId: $("#bodyId").val() || "",
            engineId: $("#engineId").val() || "",
            yearFrom: $("#yearFrom").val() || "",
            yearTo: $("#yearTo").val() || "",
            driveType: $("#driveId").val() || "",
            SlmCode: $("#salesmanId").val() || "",
            CusCode: $("#customerId").val() || "",
            Company: companies
        };
        return request;
    }
    //get autofill
    async function getAutofill() {

    }
    //get search by field data by value
    async function loadSearchProductField() {
        const btn = $("#btnSearchProductField");
        btn.prop("disabled", true);
        showSkel();
        try {
            const request = await getSearchFieldObject();
            if (!request.searchText) {
                Swal.fire({
                    icon: 'warning',
                    title: 'กรุณาเลือก',
                    text: 'Please enter search text.'
                });
                return;
            }
            if (request.searchFields.length === 0) {
                Swal.fire({
                    icon: 'warning',
                    title: 'กรุณาเลือก',
                    text: 'Please select search mode.'
                });
                return;
            }

            const response = await fetch(
                '@Url.Action("GetProductBySearchField","Product")',
                {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "Accept": "application/json"
                    },
                    body: JSON.stringify(request)
                }
            );

            const responseText = await response.text();

            let result;

            try {
                result = JSON.parse(responseText);
            } catch (e) {
                throw new Error("Server response is not JSON: " + responseText);
            }

            if (!result.IsSuccess) {
                throw new Error(result.Message || "Search Error");
            }

            $("#cacheStatusField").html(
                (result.IsFromCache ? "Cache Hit" : "API Call") +
                " (" + result.ExecutionTime + " ms)"
            );

            const filteredData = (result.Data || []).filter(g => g.productList?.length > 0);
            _setBaseProducts(filteredData, 'part');

        } catch (ex) {
            console.error(ex);
            Swal.fire({
                icon: 'error',
                title: 'เกิดข้อผิดพลาด',
                text: ex.message
            });
        } finally {
            hideSkel();
            btn.prop("disabled", false);
        }
    }

    // ─── Year Picker (vanilla, ไม่พึ่ง library) ───
    function createYearPicker(inputId, panelId, opts) {
        opts = opts || {};
        const input = document.getElementById(inputId);
        const panel = document.getElementById(panelId);

        const YEAR_MIN = 1990;
        const YEAR_MAX = new Date().getFullYear();

        let decadeStart = YEAR_MAX - (YEAR_MAX % 10) - 10;

        const state = {
            selected: null,
            decadeStart: decadeStart
        };

        function render() {
            const years = [];
            for (let i = -1; i <= 10; i++) years.push(state.decadeStart + i);

            let html = `
            <div class="yp-header">
                <span class="yp-nav" data-act="prev">‹</span>
                <span>${state.decadeStart + 1} - ${state.decadeStart + 10}</span>
                <span class="yp-nav" data-act="next">›</span>
            </div>
            <div class="yp-grid">
        `;
            years.forEach(y => {
                const isOut = (y <= state.decadeStart || y > state.decadeStart + 10);
                const isSelected = state.selected === y;

                // ✅ จำกัด global min/max ก่อน แล้วค่อย apply limitFn
                const outOfGlobalRange = y < YEAR_MIN || y > YEAR_MAX;
                const isDisabled = outOfGlobalRange || (opts.limitFn ? !opts.limitFn(y) : false);

                html += `<div class="yp-cell ${isOut ? 'outrange' : ''} ${isSelected ? 'selected' : ''} ${isDisabled ? 'disabled' : ''}" data-year="${y}">${y}</div>`;
            });
            html += `</div>`;
            panel.innerHTML = html;
        }

        function open() {
            if (input.disabled) return;
            document.querySelectorAll('.yp-panel.open').forEach(p => {
                if (p !== panel) p.classList.remove('open');
            });

            // ✅ ย้าย panel ไปติด body ก่อน render เพื่อหนี parent ที่ clip
            if (panel.parentElement !== document.body) {
                document.body.appendChild(panel);
            }

            render();

            const rect = input.getBoundingClientRect();
            panel.style.top = (rect.bottom + 4) + 'px';
            panel.style.left = rect.left + 'px';

            panel.classList.add('open');
        }

        function close() {
            panel.classList.remove('open');
        }

        input.addEventListener('click', (e) => {
            e.stopPropagation();
            panel.classList.contains('open') ? close() : open();
        });

        panel.addEventListener('click', (e) => {
            e.stopPropagation(); // ✅ เพิ่มบรรทัดนี้บรรทัดเดียว

            const nav = e.target.closest('.yp-nav');
            if (nav) {
                state.decadeStart += (nav.dataset.act === 'next' ? 10 : -10);
                render();
                return;
            }
            const cell = e.target.closest('.yp-cell');
            if (cell && !cell.classList.contains('disabled')) {
                state.selected = parseInt(cell.dataset.year, 10);
                input.value = state.selected;
                close();
                if (typeof opts.onChange === 'function') opts.onChange(state.selected);
            }
        });

        document.addEventListener('click', (e) => {
            if (!panel.contains(e.target) && e.target !== input) close();
        });

        return {
            clear() {
                state.selected = null;
                input.value = '';
            },
            setLimit(fn) {
                opts.limitFn = fn;
            },
            getYear() {
                return state.selected;
            }
        };
    }

    function initYearPickers() {
        ypFrom = createYearPicker('yearFrom', 'ypPanelFrom', {
            onChange: (year) => {
                // ✅ ถ้า To มีค่าอยู่ และน้อยกว่าหรือเท่ากับ From → clear
                if (ypTo.getYear() && year >= ypTo.getYear()) {
                    ypTo.clear();
                }
                // ✅ To ต้องมากกว่า From เท่านั้น (ไม่ใช่เท่ากัน)
                ypTo.setLimit(y => y > year);
                activateSec(1);
                updateVehSummary();
            }
        });

        ypTo = createYearPicker('yearTo', 'ypPanelTo', {
            onChange: (year) => {
                if (ypFrom.getYear() && year <= ypFrom.getYear()) {
                    ypFrom.clear();
                }
                // ✅ From ต้องน้อยกว่า To เท่านั้น
                ypFrom.setLimit(y => y < year);
                activateSec(1);
                updateVehSummary();
            }
        });
    }

    function setYearRangeDisabled(disabled) {
        $("#yearFrom, #yearTo").prop('disabled', disabled);
        if (disabled) {
            ypFrom && ypFrom.clear();
            ypTo && ypTo.clear();
        }
    }

    //---------------- Popup LoadGroup --------------------//
    let _vehiclePromptShown = false;

    function _isUnselected(val) {
        return !val || val === 'ALL';
    }

    function showVehiclePrompt(onYes, onNo) {
        if (window._swalShowing) return; // ✅ ถ้า Swal กำลังแสดงอยู่ → ไม่ทำอะไรเลย

        const hasMaker = $("#makerId").val();
        const hasRange = !_isUnselected($("#rangeId").val());
        const hasAnyFilter = hasMaker || hasRange
            || !_isUnselected($("#marketsegId").val())
            || !_isUnselected($("#segmentId").val())
            || $("#yearFrom").val()
            || $("#yearTo").val()
            || $("#driveId").val()
            || Object.keys(chkState.pl).length > 0
            || Object.keys(chkState.br).length > 0
            || fitState.size > 0;

        if (_vehiclePromptShown || hasAnyFilter) {
            onNo();
            return;
        }

        _vehiclePromptShown = true;
        window._swalShowing = true;

        Swal.fire({
            icon: false,
            title: '⚡ เพิ่มความเร็วในการค้นหา',
            html: `
            <p style="margin:0;font-size:14px;color:#555;">
                เพื่อให้ระบบค้นหาสินค้าได้รวดเร็วยิ่งขึ้น<br>
                กรุณาเลือก<strong> รุ่นรถ </strong>ที่ต้องการค้นหาเพิ่มเติม
            </p>
        `,
            showCancelButton: true,
            confirmButtonText: 'ค้นหาโดยรุ่นรถ',
            cancelButtonText: 'ยืนยันการค้นหา',
            confirmButtonColor: '#e63946',
            cancelButtonColor: '#aaa',
            allowOutsideClick: false,
        }).then((result) => {
            window._swalShowing = false;
            if (result.isConfirmed) {
                onYes();
            } else {
                onNo();
            }
        });
    }

    function goToVehicleFilter() {
        const vfBody = document.getElementById('vfBody');
        if (vfBody && !vfBody.classList.contains('show')) {
            const hd = document.querySelector("[onclick*=\"'vfBody'\"]");
            if (hd) hd.click();
        }

        setTimeout(() => {
            const maker = document.getElementById('makerId');
            if (!maker) return;

            maker.scrollIntoView({ behavior: 'smooth', block: 'center' });

            setTimeout(() => {
                maker.style.transition = 'box-shadow 0.2s, border-color 0.2s';
                maker.style.boxShadow = '0 0 0 3px #e6394680';
                maker.style.borderColor = '#e63946';
                maker.focus();

                let count = 0;
                const blink = setInterval(() => {
                    maker.style.boxShadow = count % 2 === 0
                        ? '0 0 0 3px #e6394680'
                        : '0 0 0 3px #e6394620';
                    count++;
                    if (count >= 6) {
                        clearInterval(blink);
                        // ✅ เคลียร์ style ออกเมื่อ blink จบ
                        maker.style.boxShadow = '';
                        maker.style.borderColor = '';
                        maker.style.transition = '';
                    }
                }, 300);

                // ✅ เคลียร์ทันทีเมื่อ user คลิก
                const clearHighlight = () => {
                    clearInterval(blink);
                    maker.style.boxShadow = '';
                    maker.style.borderColor = '';
                    maker.style.transition = '';
                    maker.removeEventListener('mousedown', clearHighlight);
                    maker.removeEventListener('change', clearHighlight);
                };
                maker.addEventListener('mousedown', clearHighlight);
                maker.addEventListener('change', clearHighlight);

            }, 400);
        }, 200);
    }
    //---------------------------------------------------------//

    document.addEventListener('DOMContentLoaded', function () {
        initYearPickers();

        // ✅ ผูก onchange หลังจาก init เสร็จแล้วเท่านั้น
        function bindChangeEvents() {
            document.getElementById('marketsegId')
                .addEventListener('change', () => { loadMaker(); loadModelRange(); });
            document.getElementById('segmentId')
                .addEventListener('change', () => { loadMaker(); loadModelRange(); });
            document.getElementById('makerId')
                .addEventListener('change', () => loadModelRange());
            document.getElementById('rangeId')
                .addEventListener('change', () => { loadBody(); loadEngine(); });
        }

        Promise.all([
            loadMasterMarketDefault(1),
            loadMasterMarketDefault(2)
        ]).then(async () => {
            const marketSeg = document.getElementById('marketsegId');
            const vehicleSeg = document.getElementById('segmentId');

            if (marketSeg) {
                const japanOpt = Array.from(marketSeg.options)
                    .find(o => o.text.trim().toUpperCase().includes('JAPAN'));
                if (japanOpt) marketSeg.value = japanOpt.value; // ✅ native ธรรมดา
            }

            if (vehicleSeg) {
                const passOpt = Array.from(vehicleSeg.options)
                    .find(o => o.text.trim().toUpperCase().includes('PASSENGER'));
                if (passOpt) vehicleSeg.value = passOpt.value; // ✅ native ธรรมดา
            }

            await loadMaker(true);
            await loadModelRange(true);
            updateVehSummary();

            bindChangeEvents(); // ✅ ผูก event หลัง init เสร็จเท่านั้น
        });
    });
    window.addEventListener('scroll', () => {
        document.querySelectorAll('.yp-panel.open').forEach(p => p.classList.remove('open'));
    }, true);

    window.addEventListener('resize', () => {
        document.querySelectorAll('.yp-panel.open').forEach(p => p.classList.remove('open'));
    });
