// ─────────── Autocomplete (Sidebar) ───────────
(function () {
    const CFG = {
        minChars: 2,
        delay: 300,
        url: null  // ไม่ set ตอน init
    };
    const S = { timer: null, ctrl: null, items: [], index: -1 };

    const $input = () => document.getElementById('txtSearchField');
    const $dd = () => document.getElementById('ecAcDropdown');

    function esc(s) {
        return String(s ?? '').replace(/[&<>"']/g, c =>
            ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }
    function hl(text, kw) {
        const safe = esc(text);
        if (!kw) return safe;
        const re = new RegExp('(' + esc(kw).replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'ig');
        return safe.replace(re, '<mark>$1</mark>');
    }

    function close() {
        const dd = $dd();
        dd.classList.remove('open');
        dd.innerHTML = '';
        $input().setAttribute('aria-expanded', 'false');
        S.items = []; S.index = -1;
    }

    function render(list, kw) {
        const dd = $dd();
        S.items = list; S.index = -1;
        if (!list.length) {
            dd.innerHTML = '<div class="ecac-empty">ไม่พบรายการ</div>';
            dd.classList.add('open');
            return;
        }
        
        dd.innerHTML = list.slice(0, 20).map((it, i) => `
    <div class="ecac-item" role="option" data-i="${i}">
        <div class="ecac-des">${hl(it.stkdes, kw)}</div>
    </div>`).join('');
        dd.classList.add('open');
        $input().setAttribute('aria-expanded', 'true');
    }

    async function fetchList(kw) {
        if (S.ctrl) S.ctrl.abort();
        S.ctrl = new AbortController();

        const apiUrl = (typeof urls !== 'undefined' && urls.getAutocompleteEcat)
            ? urls.getAutocompleteEcat
            : '/Catalog/Master/GetAutocompleteEcat';  // ✅ แก้ fallback path

        const dd = $dd();
        dd.innerHTML = '<div class="ecac-empty">กำลังค้นหา…</div>';
        dd.classList.add('open');

        const payload = {
            insearch: kw,
            cuscode: (document.getElementById('customerId')?.value) || window.APP_SESSION?.cuscode || '',
            Company: typeof getActiveCompanies === 'function' ? getActiveCompanies() : [],
            searchFields: Array.from(document.querySelectorAll('.smode-btn.active')).map(b => b.dataset.mode)
        };
        //console.log('[ecAc] call API', apiUrl, payload);  // ✅ เปลี่ยนจาก CFG.url → apiUrl

        try {
            const res = await fetch(apiUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify(payload),
                signal: S.ctrl.signal
            });
            const result = await res.json();
            //console.log('[ecAc] result', result);

            if ($input().value.trim() !== kw) return;   // user พิมพ์ต่อแล้ว ทิ้งผลเก่า
            if (!result.IsSuccess) { close(); return; }
            render(result.Data || [], kw);
        } catch (ex) {
            if (ex.name === 'AbortError') return;
            console.error('[ecAc] error', ex);
            close();
        }
    }

    function onInput() {
        clearTimeout(S.timer);
        const input = $input();
        if (!input || document.activeElement !== input) return; // ✅ เช็คว่า focus อยู่ที่ input นี้จริงๆ
        const kw = input.value.trim();
        //console.log('[ecAc] input', kw);
        if (kw.length < CFG.minChars) {
            if (S.ctrl) S.ctrl.abort();
            close();
            return;
        }
        S.timer = setTimeout(() => fetchList(kw), CFG.delay);
    }

    function select(i) {
        const it = S.items[i];
        if (!it) return;

        clearTimeout(S.timer);
        if (S.ctrl) S.ctrl.abort();
        const modes = Array.from(document.querySelectorAll('.smode-btn.active'))
            .map(b => b.dataset.mode);
        const oeOnly = modes.length === 1 && modes[0] === 'oe';

        const stk = (it.stkcode || '').trim();
        const oem = (it.oem || '').trim();
        $input().value = oeOnly ? oem : stk;

        close();

        try {
            if (typeof syncSearchText === 'function') syncSearchText('sidebar');
            else if (typeof syncSearch === 'function') syncSearch('sidebar');
        } catch (e) { console.warn('[ecAc] sync error', e); }

        $input().focus();
    }

    function onKeyDown(e) {
        const dd = $dd();
        const isOpen = dd.classList.contains('open');
        const nodes = dd.querySelectorAll('.ecac-item');

        if (e.key === 'Enter') {
            if (isOpen && S.index >= 0) { e.preventDefault(); select(S.index); }
            else close();
            return;
        }
        if (!isOpen || !nodes.length) return;

        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
            e.preventDefault();
            S.index = e.key === 'ArrowDown'
                ? (S.index + 1) % nodes.length
                : (S.index - 1 + nodes.length) % nodes.length;
            nodes.forEach((n, i) => n.classList.toggle('active', i === S.index));
            nodes[S.index].scrollIntoView({ block: 'nearest' });
        } else if (e.key === 'Escape') {
            close();
        }
    }

    function init() {
        const input = $input(), dd = $dd();
        if (!input || !dd) { console.warn('[ecAc] element not found'); return; }

        input.addEventListener('input', onInput);
        input.addEventListener('keydown', onKeyDown);

        dd.addEventListener('mousedown', function (e) {
            const item = e.target.closest('.ecac-item');
            if (item) { e.preventDefault(); select(parseInt(item.dataset.i, 10)); }
        });
        dd.addEventListener('mouseover', function (e) {
            const item = e.target.closest('.ecac-item');
            if (!item) return;
            S.index = parseInt(item.dataset.i, 10);
            dd.querySelectorAll('.ecac-item').forEach((n, i) => n.classList.toggle('active', i === S.index));
        });
        document.addEventListener('click', function (e) {
            if (!e.target.closest('#sidebarSearchWrap')) close();
        });
        //console.log('[ecAc] ready');
    }

    window.clearSearchField = function () {
        const inp = document.getElementById('txtSearchField');
        inp.value = '';
        document.getElementById('btnClearSearch').style.display = 'none';
        const hq = document.getElementById('headerQ'); if (hq) hq.value = '';
        const pq = document.getElementById('partQ'); if (pq) pq.value = '';

        if (_lastSearchType === 'part') {
            _lastSearchType = '';
            BASE_PRODUCTS = [];
            PRODUCTS = [];
            PRODUCTS_FOR_COUNT = [];
            PRODUCTS_FOR_PL_COUNT = [];
            PRODUCTS_FOR_BR_COUNT = [];
            chkState = { pl: {}, br: {} };
            fitState = new Set();
            document.querySelectorAll('.fit-chip.active').forEach(el => el.classList.remove('active'));
            if (typeof pgmResetSaved === 'function') pgmResetSaved();
            _sidebarForcedReset = true;
            renderProducts([]);
            _updateSidebar();
            renderActiveFilterChips();
        } else {
            syncSearch('sidebar');
        }
        inp.focus();
    };

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
})();
</script>