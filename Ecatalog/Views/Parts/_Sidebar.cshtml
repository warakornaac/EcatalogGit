@*<script>
    $(document).ready(function () {

        // ════════════════════════════════
        // EVENT BINDINGS — ทั้งหมดอยู่ใน ready
        // ════════════════════════════════

        // Market / Vehicle → reload ทุกอย่างใหม่
        $('#market-select, #vehicle-select').on('change', function () {
            MakerLoader();
            clearModelrange();
            clearModel();
            clearBody();
            clearEngine();
        });

        // Maker → โหลด Range ใหม่
        $('#maker-select').on('change', function () {
            clearModelrange();
            clearModel();
            clearBody();
            clearEngine();
            modelRangeLoader();
        });

        // Range → โหลด Model ใหม่
        $('#range-select').on('change', function () {
            clearModel();
            clearBody();
            clearEngine();
            modelLoader();
        });

        // Model → โหลด Body ใหม่
        $('#model-select').on('change', function () {
            clearBody();
            clearEngine();
            bodyLoader();
        });

        // Body → โหลด Engine ใหม่
        $('#body-select').on('change', function () {
            clearEngine();
            engineLoader();
        });


        // ════════════════════════════════
        // INITIAL LOAD
        // ════════════════════════════════
        MarketSegLoader();
        VehicleSegLoader();
        MakerLoader();
        modelRangeLoader();
        modelLoader();
        bodyLoader();
        engineLoader();

        $.fn.dataTable.ext.errMode = 'none';
    });

    // ════════════════════════════════
    // CLEAR HELPERS
    // ════════════════════════════════
    function clearALL() {
        MakerLoader();
        modelRangeLoader();
        modelLoader();
        bodyLoader();
        engineLoader();
    }

    function clearModelrange() {
        $('#range-select').html('<option value="ALL" selected>ALL</option><option value="">No ModelRange</option>');
    }
    function clearModel() {
        $('#model-select').html('<option value="ALL" selected>ALL</option>');
    }
    function clearBody() {
        $('#body-select').html('<option value="ALL" selected>ALL</option>');
    }
    function clearEngine() {
        $('#engine-select').html('<option value="ALL" selected>ALL</option>');
    }

    // ════════════════════════════════
    // LOADERS
    // ════════════════════════════════
    function MarketSegLoader() {
        console.log('MarketSegLoader called'); // ← ดูว่า function ถูกเรียกมั้ย
        $.ajax({
            url: '@Url.Action("GetVIO_MarketSeg", "TruAutoparts")',
            type: 'POST',
            dataType: 'json',
            success: function (data) {
                console.log('MarketSeg response:', data); // ← ดูว่า API ตอบอะไร
                if (data.respone === true) {
                    var opt = '<option value="ALL" selected>ALL</option>';
                    data.result.forEach(function (item) {
                        opt += '<option value="' + item.ID + '">' + item.MarketSegment + '</option>';
                    });
                    $('#market-select').html(opt);
                    console.log('market-select element:', $('#market-select').length); // ← ดูว่าเจอ element มั้ย
                }
            },
            error: function (xhr, status, err) {
                console.error('MarketSegLoader FAILED:', xhr.status, status, err);
                console.error('Response:', xhr.responseText); // ← ดู error จาก server
            }
        });
    }

    function VehicleSegLoader() {
        $.ajax({
            url: '@Url.Action("GetVIO_VehicleSegment", "TruAutoparts")',
            type: 'POST',
            dataType: 'json',
            success: function (data) {
                if (data.respone === true) {
                    var opt = '<option value="ALL" selected>ALL</option>';
                    data.result.forEach(function (item) {
                        opt += '<option value="' + item.ID + '">' + item.VehicleSegment + '</option>';
                    });
                    $('#vehicle-select').html(opt);
                }
            },
            error: function (xhr, status, err) {
                console.error('VehicleSegLoader error:', status, err);
            }
        });
    }

    function MakerLoader() {
        var market  = $('#market-select').val();
        var vehicle = $('#vehicle-select').val();
        $.ajax({
            url: '@Url.Action("GetVIO_Maker", "UpLoadDataVIO")',
            type: 'POST',
            dataType: 'json',
            data: { MarketSegID: market, VehicleSegID: vehicle },
            beforeSend: function () {
                $('#maker-select').html('<option value="ALL" selected>ALL</option>');
            },
            success: function (data) {
                if (data.respone == true && data.result.length > 0) {
                    var opt = '<option value="ALL" selected>ALL</option>';
                    data.result.forEach(function (item) {
                        opt += '<option value="' + item.ID + '">' + item.Maker + '</option>';
                    });
                    $('#maker-select').html(opt);
                }
            },
            error: function (xhr, status, err) {
                console.error('MakerLoader error:', status, err);
            }
        });
    }

    function modelRangeLoader() {
        var makerId = $('#maker-select').val();
        $.ajax({
            url: '@Url.Action("GetVIO_ModelRange", "UpLoadDataVIO")',
            type: 'POST',
            dataType: 'json',
            data: { MakerID: makerId },
            beforeSend: function () { clearModelrange(); },
            success: function (data) {
                if (data.respone === true) {
                    var opt = '<option value="ALL" selected>ALL</option><option value="">No ModelRange</option>';
                    data.result.forEach(function (item) {
                        opt += '<option data-maker="' + item.Maker_ID + '" value="' + item.ID + '">' + item.ModelRange + '</option>';
                    });
                    $('#range-select').html(opt);
                } else {
                    clearModelrange();
                }
            },
            error: function (xhr, status, err) {
                console.error('modelRangeLoader error:', status, err);
            }
        });
    }

    function modelLoader() {
        var marketId = $('#market-select').val();
        var makerId  = $('#maker-select').val();
        var rangeId  = $('#range-select').val();
        $.ajax({
            url: '@Url.Action("GetVIO_Model", "UpLoadDataVIO")',
            type: 'POST',
            dataType: 'json',
            data: { MarketSegID: marketId, MakerID: makerId, ModelRangID: rangeId },
            beforeSend: function () { clearModel(); },
            success: function (data) {
                if (data.respone === true) {
                    var opt = '<option value="ALL" selected>ALL</option>';
                    data.result.forEach(function (item) {
                        opt += '<option value="' + item.ID + '">' + item.Model + '</option>';
                    });
                    $('#model-select').html(opt);
                } else {
                    clearModel();
                }
            },
            error: function (xhr, status, err) {
                console.error('modelLoader error:', status, err);
            }
        });
    }

    function bodyLoader() {
        var marketId     = $('#market-select').val();
        var vehicleId    = $('#vehicle-select').val();
        var makerId      = $('#maker-select').val();
        var modelRangeId = $('#range-select').val();
        var modelId      = $('#model-select').val();
        $.ajax({
            url: '@Url.Action("GetVIO_Body", "UpLoadDataVIO")',
            type: 'POST',
            dataType: 'json',
            data: { marketSeg: marketId, vehicleSeg: vehicleId, makerID: makerId, modelID: modelId, modelRangeID: modelRangeId },
            beforeSend: function () { clearBody(); },
            success: function (data) {
                if (data.respone === true) {
                    var opt = '<option value="ALL" selected>ALL</option>';
                    data.result.forEach(function (item) {
                        opt += '<option value="' + item.ID + '">' + item.Body + '</option>';
                    });
                    $('#body-select').html(opt);
                } else {
                    clearBody();
                }
            },
            error: function (xhr, status, err) {
                console.error('bodyLoader error:', status, err);
            }
        });
    }

    function engineLoader() {
        var makerId      = $('#maker-select').val();
        var modelRangeId = $('#range-select').val();
        var modelId      = $('#model-select').val();
        var bodyId       = $('#body-select').val();
        $.ajax({
            url: '@Url.Action("GETVIO_Engine", "UpLoadDataVIO")',
            type: 'POST',
            dataType: 'json',
            data: { makerID: makerId, modelRangeID: modelRangeId, modelID: modelId, bodyID: bodyId },
            beforeSend: function () { clearEngine(); },
            success: function (data) {
                if (data.respone === true) {
                    var opt = '<option value="ALL" selected>ALL</option>';
                    data.result.forEach(function (engine) {
                        opt += '<option value="' + engine.ID + '">' + engine.EngineType + '</option>';
                    });
                    $('#engine-select').html(opt);
                } else {
                    clearEngine();
                }
            },
            error: function (xhr, status, err) {
                console.error('engineLoader error:', status, err);
            }
        });
    }

    // ════════════════════════════════
    // TABLE LOADERS
    // ════════════════════════════════
    function LoadVIOData() {
        $.ajax({
            url: '@Url.Action("GetVIOData", "UpLoadDataVIO")',
            type: 'POST',
            dataType: 'json',
            data: {},
            beforeSend: function () {
                $('#table-vio tbody').html('<tr><td class="text-center" colspan="16"><i class="fa fa-circle-o-notch fa-spin" style="font-size:24px"></i> Loading...</td></tr>');
            },
            success: function (data) {
                renderVIOTable(data);
            },
            error: function (xhr, status, err) {
                console.error('LoadVIOData error:', status, err);
            }
        });
    }

    function SearchVIOData() {
        var market  = $('#market-select').val();
        var vehicle = $('#vehicle-select').val();
        var maker   = $('#maker-select').val();
        var range   = $('#range-select').val();
        var model   = $('#model-select').val();
        var body    = $('#body-select').val();
        var engine  = $('#engine-select').val();

        $.ajax({
            url: '@Url.Action("GetVIOData", "UpLoadDataVIO")',
            type: 'POST',
            dataType: 'json',
            data: { marketID: market, vehicleID: vehicle, maker: maker, rangID: range, modelID: model, bodyID: body, engineID: engine },
            beforeSend: function () {
                Swal.fire({
                    title: 'Searching...',
                    text: 'Please wait while we processing on the product.',
                    allowOutsideClick: false,
                    didOpen: function () { Swal.showLoading(); }
                });
                $('#table-vio tbody').html('<tr><td class="text-center" colspan="16"><i class="fa fa-circle-o-notch fa-spin" style="font-size:24px"></i> Loading...</td></tr>');
            },
            success: function (data) {
                Swal.close();
                renderVIOTable(data);
            },
            error: function (xhr, status, err) {
                Swal.close();
                console.error('SearchVIOData error:', status, err);
            }
        });
    }

    // ── shared table renderer ──
    function renderVIOTable(data) {
        var html = '';
        $('#table-vio tbody').html('');

        if ($.fn.DataTable.isDataTable('#table-vio')) {
            $('#table-vio').DataTable().clear().destroy();
        }

        if (data.respone === true && data.result.length > 0) {
            $('#item-count').text(data.result.length + ' Item');
            data.result.forEach(function (item) {
                html += '<tr>' +
                    '<td class="text-center">' + item.KType + '</td>' +
                    '<td class="text-center">' + item.MarketSegment + '</td>' +
                    '<td class="text-center">' + item.VehicleSegment + '</td>' +
                    '<td class="text-center">' + item.Maker + '</td>' +
                    '<td class="text-center">' + item.ModelRange + '</td>' +
                    '<td class="text-center">' + item.Model + '</td>' +
                    '<td class="text-center">' + item.Body + '</td>' +
                    '<td class="text-center">' + item.BodyType + '</td>' +
                    '<td class="text-center">' + item.DriveType + '</td>' +
                    '<td class="text-center">' + item.EngineType + '</td>' +
                    '<td class="text-center">' + item.Strokes + '</td>' +
                    '<td class="text-center">' + item.FuelType + '</td>' +
                    '<td class="text-center">' + item.YearFrom + '</td>' +
                    '<td class="text-center">' + item.YearTo + '</td>' +
                    '<td class="text-center">' + item.ThailandVIO + '</td>' +
                    '<td class="text-center">' + item.TruType + '</td>' +
                    '</tr>';
            });
            $('#table-vio tbody').html(html);
        } else {
            $('#item-count').text('0 Item');
            $('#table-vio tbody').html('<tr><td colspan="16" class="text-center">No Data</td></tr>');
        }

        $('#table-vio').dataTable({
            paging: true,
            pageLength: 20,
            lengthChange: false,
            searching: false,
            ordering: false,
            language: {
                info: "แสดง _START_ ถึง _END_ จากทั้งหมด _TOTAL_ ",
                infoEmpty: "ไม่มีข้อมูลให้แสดง"
            }
        });
        }

        function toggleSection(bodyId, secNo) {
            activateSec(secNo);
            const target = document.getElementById(bodyId);
            if (!target) return;
            const bsCollapse =
                bootstrap.Collapse.getOrCreateInstance(target);
            if (target.classList.contains('show')) {
                bsCollapse.hide();
            } else {
                bsCollapse.show();
            }
        }

        $.ajax({
            url: '@Url.Action("GetCatProductGroupline", "DataCenter")',
            data: {
                com: _var,
                progroup: "",
                brand: "",
                cuscod: cuscod
            },
            type: "POST",
            dataType: "JSON",
            success: function (data) {
                //console.log(data)
                var select = $("#productline");
                select.children().remove();
                select.prepend($("<option>").val("").text("ประเภทสินค้า(Product Line)"));
                $(data).each(function (index, item) {
                    select.append($("<option custyp='" + item.ProductGroup + "'>").val(item.ProductLine).text(item.ProductLine));
                });
                $("#productline").selectpicker('refresh');
                $(".selectpicker #productline").selectpicker({
                    noneSelectedText: 'Product Line All' // by this default 'Nothing selected' -->will change to Please Select
                });
            }
        });

