        getBrands: '@Url.Action("GetBrands", "Master")',
        getProductGroups: '@Url.Action("GetProductGroups", "Master")',
        getMatchProductionGroup: '@Url.Action("getMatchProductionGroup", "Master")',
        getSalesmanAll: '@Url.Action("GetSalesmanAll", "Master")',
