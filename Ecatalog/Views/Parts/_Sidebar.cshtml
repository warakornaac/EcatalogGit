<script>
async function loadModelRange() {

    try {

        const marketSegmentId = $("#marketsegId").val();
        const segmentId = $("#segmentId").val();
        const makerId = $("#makerId").val();

        // ถ้ายังเลือกไม่ครบ 3 ค่า
        if (!marketsegId || !segmentId || !makerId) {
            $("#rangeId").empty().append('<option value="">— Select Range —</option>');
            return;
        }

        const params = new URLSearchParams({
            marketSegmentId,
            segmentId,
            makerId
        });

        const response = await fetch(`@Url.Action("GetModelRange", "Master")?${params}`,{
                method: 'GET'
            });

        const result = await response.json();
        let ddl = $("#rangeId");
        ddl.empty();
        ddl.append('<option value="">— Select Range —</option>');

        if (result.IsSuccess && result.Data) {

            result.Data.forEach(item => {

                ddl.append(`
                    <option value="${item.Id}">
                        ${item.Model}
                    </option>
                `);

            });
        }

    }
    catch (error) {

        console.error(error);

        alert("Load Model Range Failed");

    }
}
</script>