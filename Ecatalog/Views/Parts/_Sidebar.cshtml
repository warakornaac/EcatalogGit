<!-- ═══ APP LAYOUT ═══ -->
@*<div class="app-layout">*@

<!-- ════ SIDEBAR ════ -->
<aside class="sidebar" id="sidebar" role="complementary" aria-label="Filter sidebar">
    <div class="sidebar-inner mt-5 mb-5">

        <!-- §1 Vehicle Filter -->
        <div class="sec-hd" data-bs-toggle="collapse" data-bs-target="#vfBody" aria-expanded="true" onclick="activateSec(1)">
            <span class="sec-title">Vehicle Filter</span>
            <i class="bi bi-chevron-down sec-chevron"></i>
        </div>
        <div class="collapse show" id="vfBody">
            <div class="filter-body mt-2">
                <div class="mb-2">
                    <div class="flabel">Market Segment</div>
                    <select class="fselect" id="marketsegId" onchange="loadModelRange();">
                        <option value="">— Select Market —</option>
                    </select>
                </div>
                <div class="mb-2">
                    <div class="flabel">Vehicle Segment</div>
                    <select class="fselect" id="segmentId" onchange="loadModelRange();">
                        <option value="">— Select Segment —</option>
                    </select>
                </div>
                <div class="mb-2">
                    <div class="flabel">Maker</div>
                    <select class="fselect" id="makerId" onchange="loadModelRange();">
                        <option value="">— Select Maker —</option>
                    </select>
                </div>
                <div class="mb-2">
                    <div class="flabel">Model Range</div>
                    <select class="fselect" id="rangeId" onchange="loadBody();">
                        <option value="">— Select Range —</option>
                    </select>
                </div>
                <div class="mb-2">
                    <div class="flabel">Model Body</div>
                    <select class="fselect" id="bodyId" onchange="loadEngine();">
                        <option value="">— Select Body —</option>
                    </select>
                </div>
                <div class="mb-2">
                    <div class="flabel">Engine</div>
                    <select class="fselect" id="engineId"  onchange="updateVehSummary()">
                        <option value="">— Select Engine —</option>
                    </select>
                </div>
                <div class="mb-2">
                    <div class="flabel">Year Range</div>
                    <div class="yr-range">
                        <input type="number" id="yearFrom" placeholder="Date From" onchange="activateSec(1)">
                        <span>–</span>
                        <input type="number" id="yearTo" placeholder="Date To" onchange="activateSec(1)">
                    </div>
                </div>
                <div class="mb-1">
                    <div class="flabel">Drive System</div>
                    <select class="fselect" id="driveId"  onchange="updateVehSummary()">
                        <option value="">— Select Drive —</option>
                        <option value="FWD">FWD</option>
                        <option value="RWD">RWD</option>
                        <option value="AWD">4WD / AWD</option>
                        <option value="NA">NA</option>
                    </select>
                </div>
                <div class="ftags" id="vfTags"></div>
                <button class="search-btn" id="btnSearchProductVio" onclick="loadSearchProductVio()">
                    <i class="bi bi-lightning-charge-fill"></i> Search Vehicle
                </button>
                <div class="mb-1">
                    <div>
                        <span id="cacheStatus">-</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="step-line"><div class="ln"></div></div>

        <!-- §2 Search Panel -->
        <div class="sec-hd" data-bs-toggle="collapse" data-bs-target="#spBody" aria-expanded="true" onclick="activateSec(2)">
            <span class="sec-title">Part Search</span>
            <i class="bi bi-chevron-down sec-chevron"></i>
        </div>
        <div class="collapse show" id="spBody">
            <div class="filter-body">
                <div class="flabel mb-1">Search Mode <span style="color:var(--purple);font-size:9px;font-weight:700">(multi-select)</span></div>
                <!-- Multi-select search mode (click to toggle each) -->
                <div class="smode-group" id="smodeGroup">
                    <label class="smode-btn active" data-mode="description" onclick="toggleMode(this)">
                        <i class="bi bi-card-text"></i> Description
                    </label>
                    <label class="smode-btn" data-mode="oe" onclick="toggleMode(this)">
                        <i class="bi bi-upc-scan"></i> OE
                    </label>
                    <label class="smode-btn" data-mode="competitor" onclick="toggleMode(this)">
                        <i class="bi bi-arrows-collapse"></i> Competitor
                    </label>
                </div>
                <div class="sinput-wrap mt-1" id="sidebarSearchWrap">
                    <!-- Sidebar search input (synced with header) -->
                    <input type="text" id="partQ" placeholder="Type part name or code…" oninput="syncSearch('sidebar');acInputSidebar(this)" onkeydown="acKeyNavSidebar(event)" autocomplete="off" aria-autocomplete="list" aria-expanded="false">
                    <i class="bi bi-search"></i>
                    <!-- Sidebar Autocomplete Dropdown -->
                    <div class="ac-dropdown" id="acDropdownSidebar" role="listbox"></div>
                </div>
                <button class="search-btn" id="" onclick="runSearch()">
                    <i class="bi bi-lightning-charge-fill"></i> Search Parts
                </button>
            </div>
        </div>

        <div class="step-line"><div class="ln"></div></div>

