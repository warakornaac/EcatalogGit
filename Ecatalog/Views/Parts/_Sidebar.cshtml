@{
    Layout = null;
    var SessionslmCode = ViewBag.slmCode;
    var SessioncusCode = ViewBag.cusCode;
}

<!-- ════ SIDEBAR ════ -->
<aside class="sidebar" id="sidebar" role="complementary" aria-label="Filter sidebar">
    <div class="sidebar-inner mb-7">
        @if (this.Session["UserType"] != null && (int)this.Session["UserType"] == 1)
        {
            if (this.Session["slmcode"] != null)
            {
                <div class="sb-sc-bar">
                    <div class="sb-sc-row">
                        <div class="sb-sc-field">
                            <label class="sb-sc-label" for="salesmanId">Salesman</label>
                            <select class="sb-select sb-select-sm" id="salesmanId">
                                <option value="">@ViewBag.slmCode</option>
                            </select>
                        </div>
                        @if (this.Session["cusCode"] != null)
                        {
                            <div class="sb-sc-field">
                                <label class="sb-sc-label" for="customerId">Customer</label>
                                <select class="sb-select sb-select-sm" id="customerId">
                                    <option value="">@ViewBag.cusCode</option>
                                </select>
                            </div>
                        }
                    </div>
                    <div class="company-group" role="group" aria-label="Company">
                        <button class="company-btn" data-company="AAC" onclick="toggleCompany(this)" aria-pressed="false">AAC</button>
                        <button class="company-btn" data-company="TAC" onclick="toggleCompany(this)" aria-pressed="false">TAC</button>
                        <button class="company-btn" data-company="TAM" onclick="toggleCompany(this)" aria-pressed="false">TAM</button>
                    </div>
                </div>
            }
        }

        <div class="sec-hd" aria-expanded="true" onclick="toggleSec(this, 'vfBody'); activateSec(1)">
            <span class="sec-title">Vehicle Filter</span>
            <i class="bi bi-chevron-down sec-chevron"></i>
        </div>
        <div class="collapse show" id="vfBody">
            <div class="filter-body mt-2">
                <div class="mb-2">
                    <div class="flabel">Market Segment</div>
                    <select class="fselect" id="marketsegId" onchange="loadModelRange();">
                        <option value="">— Select Market —</option>
                    </select>
                </div>
                <div class="mb-2">
                    <div class="flabel">Vehicle Segment</div>
                    <select class="fselect" id="segmentId" onchange="loadModelRange();">
                        <option value="">— Select Segment —</option>
                    </select>
                </div>
                <div class="mb-2">
                    <div class="flabel">Maker</div>
                    <select class="fselect" id="makerId" onchange="loadModelRange();">
                        <option value="">— Select Maker —</option>
                    </select>
                </div>
                <div class="mb-2">
                    <div class="flabel">Model Range</div>
                    <select class="fselect" id="rangeId" onchange="loadBody();">
                        <option value="">— Select Range —</option>
                    </select>
                </div>
                <div class="mb-2">
                    <div class="flabel">Model Body</div>
                    <select class="fselect" id="bodyId" onchange="loadEngine();">
                        <option value="">— Select Body —</option>
                    </select>
                </div>
                <div class="mb-2">
                    <div class="flabel">Engine</div>
                    <select class="fselect" id="engineId" onchange="updateVehSummary()">
                        <option value="">— Select Engine —</option>
                    </select>
                </div>
                <div class="mb-2">
                    <div class="flabel">Year Range</div>
                    <div class="yr-range">
                        <input type="number" id="yearFrom" placeholder="Date From" onchange="activateSec(1)">
                        <span>–</span>
                        <input type="number" id="yearTo" placeholder="Date To" onchange="activateSec(1)">
                    </div>
                </div>
                <div class="mb-1">
                    <div class="flabel">Drive System</div>
                    <select class="fselect" id="driveId" onchange="updateVehSummary()">
                        <option value="">— Select Drive —</option>
                        <option value="FWD">FWD</option>
                        <option value="RWD">RWD</option>
                        <option value="AWD">4WD / AWD</option>
                        <option value="NA">NA</option>
                    </select>
                </div>
                <div class="ftags" id="vfTags"></div>
                <button class="search-btn" id="btnSearchProductVio" onclick="loadSearchProductVio()">
                    <i class="bi bi-lightning-charge-fill"></i> Search Vehicle
                </button>
                <div class="mb-1">
                    <div>
                        <span id="cacheStatus">-</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="sec-hd" aria-expanded="true" onclick="toggleSec(this, 'spBody'); activateSec(2)">
            <span class="sec-title">Part Search</span>
            <i class="bi bi-chevron-down sec-chevron"></i>
        </div>
        <div class="collapse show" id="spBody">
            <div class="filter-body">
                <div class="flabel mb-1">Search Mode <span style="color:var(--purple);font-size:9px;font-weight:700">(multi-select)</span></div>
                <div class="smode-group" id="smodeGroup">
                    <label class="smode-btn active" data-mode="description" onclick="toggleMode(this)">
                        <i class="bi bi-card-text"></i> Description
                    </label>
                    <label class="smode-btn" data-mode="oe" onclick="toggleMode(this)">
                        <i class="bi bi-upc-scan"></i> OE
                    </label>
                    <label class="smode-btn" data-mode="competitor" onclick="toggleMode(this)">
                        <i class="bi bi-arrows-collapse"></i> Competitor
                    </label>
                </div>
                <div class="sinput-wrap mt-1" id="sidebarSearchWrap">
                    <input type="text" id="partQ" placeholder="Type part name or code…" oninput="syncSearch('sidebar');acInputSidebar(this)" onkeydown="acKeyNavSidebar(event)" autocomplete="off" aria-autocomplete="list" aria-expanded="false">
                    <i class="bi bi-search"></i>
                    <div class="ac-dropdown" id="acDropdownSidebar" role="listbox"></div>
                </div>
                <button class="search-btn" id="" onclick="runSearch()">
                    <i class="bi bi-lightning-charge-fill"></i> Search Parts
                </button>
            </div>
        </div>

        <div class="collapse show" id="sfBody">
            <div class="filter-body">
                <div class="flabel">Product Line (สายผลิตภัณฑ์)</div>
                <div class="chk-list" id="plList"></div>

                <button class="see-more-btn" id="plSeeMore" onclick="toggleSeeMore('pl')">
                    <i class="bi bi-chevron-down" id="plSeeMoreIcon"></i> ดูเพิ่มเติม
                </button>

                <div class="flabel mt-3">Fitting</div>
                <div class="fit-grid" id="fitGrid">
                    <div class="fit-chip" onclick="toggleFit(this,'หน้า')">หน้า</div>
                    <div class="fit-chip" onclick="toggleFit(this,'หลัง')">หลัง</div>
                    <div class="fit-chip" onclick="toggleFit(this,'ซ้าย')">ซ้าย</div>
                    <div class="fit-chip" onclick="toggleFit(this,'ขวา')">ขวา</div>
                    <div class="fit-chip" onclick="toggleFit(this,'บน')">บน</div>
                    <div class="fit-chip" onclick="toggleFit(this,'ล่าง')">ล่าง</div>
                </div>

                <div class="flabel mt-3">Brand</div>
                <div class="chk-list" id="brList"></div>

                <button class="see-more-btn" id="brSeeMore" onclick="toggleSeeMore('br')">
                    <i class="bi bi-chevron-down" id="brSeeMoreIcon"></i> ดูเพิ่มเติม
                </button>
                <div class="mb-1">
                    <div>
                        <span id="cacheStatusCatagory">-</span>
                    </div>
                </div>
                <button class="search-btn" id="btnSearchProductCatagory" onclick="searchProductByCategory()">
                    <i class="bi bi-lightning-charge-fill"></i> Search Catagory
                </button>

            </div>
        </div>

    </div>
</aside>

<script>

    $(document).ready(async function () {
        //get dropdown
        await Promise.all([
            loadMasterMarketDefault(1),
            loadMasterMarketDefault(2),
            loadMasterMarketDefault(3)
        ]);

    });

    $('#yearTo').on('input', function () {
        const currentYear = new Date().getFullYear();
        if (this.value > currentYear) {
            this.value = currentYear;
        }
    });
    //get master
    async function loadMasterMarketDefault(moduleId) {
        let selectId = "marketsegId";
        let selectDefaultText = "Select Marker";
        //set moduleId
        if (moduleId == 2) {
            selectId = "segmentId";
            selectDefaultText = "Select Segment";
        } else if (moduleId == 3) {
            selectId = "makerId";
            selectDefaultText = "Select Marker";
        }

        try {
            const params = new URLSearchParams({
                moduleId: moduleId
            });
            const response = await fetch(
                `@Url.Action("GetMarketCar", "Master")?${params}`,
                {
                    method: 'GET'
                });

            const result = await response.json();
            const ddl = $("#" + selectId);
            ddl.empty();
            ddl.append('<option value="">— ' + selectDefaultText + ' —</option>');
            if (result.IsSuccess && result.Data) {
                result.Data.forEach(item => {
                    ddl.append(`
                        <option value="${item.Id}">
                            ${item.Name}
                        </option>
                    `);
                });
            }
        } catch (error) {
            console.error(error);
            alert("Load Market Segment Failed");
        }
    }
    async function loadModelRange() {
        try {
            $("#bodyId").empty().append('<option value="">— Select Body —</option>');
            $("#engineId").empty().append('<option value="">— Select Engine —</option>');

            const marketSegmentId = $("#marketsegId").val();
            const segmentId = $("#segmentId").val();
            const makerId = $("#makerId").val();

            if (!marketSegmentId || !segmentId || !makerId) {
                $("#rangeId").empty().append('<option value="">— Select Range —</option>');
                updateVehSummary();
                return;
            }

            const params = new URLSearchParams({ marketSegmentId, segmentId, makerId });
            const response = await fetch(`@Url.Action("GetModelRange", "Master")?${params}`, { method: 'GET' });
            const result = await response.json();

            const ddl = $("#rangeId");
            ddl.empty().append('<option value="">— Select Range —</option>');
            if (result.IsSuccess && result.Data) {
                result.Data.forEach(item => {
                    ddl.append(`<option value="${item.Id}">${item.Model}</option>`);
                });
            }
        } catch (error) {
            console.error(error);
            alert("Load Model Range Failed");
        } finally {
            updateVehSummary();
        }
    }
    async function loadBody() {
        try {
            const marketSegmentId = $("#marketsegId").val();
            const segmentId = $("#segmentId").val();
            const makerId = $("#makerId").val();
            const rangeId = $("#rangeId").val();

            if (!marketSegmentId || !segmentId || !makerId || !rangeId) {
                $("#bodyId").empty().append('<option value="">— Select Body —</option>');
                updateVehSummary();
                return;
            }

            const params = new URLSearchParams({ marketSegmentId, segmentId, makerId, rangeId });
            const response = await fetch(`@Url.Action("GetBody", "Master")?${params}`, { method: 'GET' });
            const result = await response.json();

            const ddl = $("#bodyId");
            ddl.empty().append('<option value="">— Select Body —</option>');
            if (result.IsSuccess && result.Data) {
                result.Data.forEach(item => {
                    ddl.append(`<option value="${item.id}">${item.body}</option>`);
                });
            }
        } catch (error) {
            console.error(error);
            alert("Load Body Failed");
        } finally {
            updateVehSummary();
        }
    }

    async function loadEngine() {
        try {
            const marketSegmentId = $("#marketsegId").val();
            const segmentId = $("#segmentId").val();
            const makerId = $("#makerId").val();
            const rangeId = $("#rangeId").val();
            const bodyId = $("#bodyId").val();

            if (!marketSegmentId || !segmentId || !makerId || !rangeId || !bodyId) {
                $("#engineId").empty().append('<option value="">— Select Engine —</option>');
                updateVehSummary();
                return;
            }

            const params = new URLSearchParams({ marketSegmentId, segmentId, makerId, rangeId, bodyId });
            const response = await fetch(`@Url.Action("GetEngine", "Master")?${params}`, { method: 'GET' });
            const result = await response.json();

            const ddl = $("#engineId");
            ddl.empty().append('<option value="">— Select Engine —</option>');
            if (result.IsSuccess && result.Data) {
                result.Data.forEach(item => {
                    ddl.append(`<option value="${item.id}">${item.engineType}</option>`);
                });
            }
        } catch (error) {
            console.error(error);
            alert("Load Engine Failed");
        } finally {
            updateVehSummary();
        }
    }
    //set params obj by select catagory
    function getSearchCatagoryObject() {

        const filterObj = {
            productGroupId:
                $(".bb-item.active")
                    .map(function () {
                        return $(this).data("id");
                    })
                    .get(),
            productLineId:
                $(".chk-item.checked[data-filter='filterProductLineId']")
                    .map(function () {
                        return $(this).data("id");
                    })
                    .get(),
            brandId:
                $(".chk-item.checked[data-filter='filterProductBrandId']")
                    .map(function () {
                        return $(this).attr("data-id");
                    })
                    .get()
        };
        console.log(filterObj);
        return filterObj;
    }
    //send params send to controller searchByCategory
    async function searchProductByCategory() {
        try {
            const filters = await getSearchCatagoryObject();
            console.log(filters);
            const response = await fetch(
                '@Url.Action("GetProductBySearchCatagory","Product")',
                {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(filters)
                });

            const result = await response.json();
            if (!response.ok) {
                throw new Error(
                    result.Message ||
                    result.errorMessage ||
                    "API Error");
            }

            if (result.IsSuccess) {
                $("#cacheStatusCatagory").html(
                    (result.IsFromCache
                        ? "Catagory Cache Hit"
                        : "API Call")
                    +
                    " (" +
                    result.ExecutionTime +
                    " ms)"
                );
                console.log(result);

            } else {
                alert(result.Message || "Search Error");
            }
        } catch (ex) {
            console.error("searchProductByCategory Error:", ex);
            alert(ex.message ||"System Error");
        }
    }
</script>