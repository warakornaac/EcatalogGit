function GetProductionLine() {
    $.ajax({
        url: '@Url.Action("GeProductLines", "Master")',
        method: 'GET',
        success: function (result) {
            if (result.IsSuccess) {
                RenderProductionLines(result.Data || []);
            } else {
                console.error("API Error:", result.Message);
            }
        },
        error: function (xhr, status, error) {
            console.error(error);
        }
    });
}

